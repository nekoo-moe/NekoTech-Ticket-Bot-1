<%
  pageTitle = 'Thống kê';
  activePage = 'statistics';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<div class="page-header">
  <h1 class="page-title">Thống kê</h1>
  <p class="page-subtitle">Tổng quan hiệu suất ticket, đánh giá và hoạt động máy chủ.</p>
</div>

<!-- Ticket stats -->
<div class="card" style="margin-bottom:var(--sp-5);">
  <div class="card-header">
    <div class="card-icon"><i class="fas fa-ticket-alt"></i></div>
    <h2 class="card-title">Ticket</h2>
  </div>
  <div class="stat-grid">
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-ticket-alt"></i></div>
      <div class="stat-tile-label">Tổng ticket</div>
      <div class="stat-tile-value"><%= (guildStats.totalTickets || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon" style="background:var(--teal-glow);color:var(--teal);"><i class="fas fa-door-open"></i></div>
      <div class="stat-tile-label">Đang mở</div>
      <div class="stat-tile-value"><%= (guildStats.openTickets || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-user-check"></i></div>
      <div class="stat-tile-label">Tổng lần nhận</div>
      <div class="stat-tile-value"><%= (guildStats.totalClaims || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-envelope"></i></div>
      <div class="stat-tile-label">Tổng tin nhắn</div>
      <div class="stat-tile-value"><%= (guildStats.totalMessages || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-clock"></i></div>
      <div class="stat-tile-label">Thời gian hoàn thành TB</div>
      <div class="stat-tile-value" style="font-size:1.1rem;"><%= guildStats.averageCompletion || 'N/A' %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-reply"></i></div>
      <div class="stat-tile-label">Thời gian phản hồi TB</div>
      <div class="stat-tile-value" style="font-size:1.1rem;"><%= guildStats.averageResponse || 'N/A' %></div>
    </div>
  </div>
</div>

<!-- Review stats -->
<div class="card" style="margin-bottom:var(--sp-5);">
  <div class="card-header">
    <div class="card-icon" style="background:oklch(0.82 0.18 80 / 0.15);color:var(--warning);"><i class="fas fa-star"></i></div>
    <h2 class="card-title">Đánh giá</h2>
  </div>
  <div class="stat-grid">
    <div class="stat-tile">
      <div class="stat-tile-icon" style="background:oklch(0.82 0.18 80 / 0.15);color:var(--warning);"><i class="fas fa-comment-alt"></i></div>
      <div class="stat-tile-label">Tổng đánh giá</div>
      <div class="stat-tile-value"><%= (guildStats.totalReviews || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon" style="background:oklch(0.82 0.18 80 / 0.15);color:var(--warning);"><i class="fas fa-star"></i></div>
      <div class="stat-tile-label">Điểm trung bình</div>
      <div class="stat-tile-value">
        <%= (guildStats.averageRating || 0).toFixed(1) %><span style="font-size:0.9rem;font-weight:400;color:var(--ink-3);">/5.0</span>
      </div>
    </div>
  </div>
</div>

<!-- Suggestion stats -->
<div class="card" style="margin-bottom:var(--sp-5);">
  <div class="card-header">
    <div class="card-icon" style="background:var(--violet-glow);color:var(--violet);"><i class="fas fa-lightbulb"></i></div>
    <h2 class="card-title">Đề xuất</h2>
  </div>
  <div class="stat-grid">
    <div class="stat-tile">
      <div class="stat-tile-icon" style="background:var(--violet-glow);color:var(--violet);"><i class="fas fa-lightbulb"></i></div>
      <div class="stat-tile-label">Tổng đề xuất</div>
      <div class="stat-tile-value"><%= (guildStats.totalSuggestions || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon" style="background:var(--teal-glow);color:var(--teal);"><i class="fas fa-thumbs-up"></i></div>
      <div class="stat-tile-label">Tổng lượt thích</div>
      <div class="stat-tile-value"><%= (guildStats.totalSuggestionUpvotes || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon" style="background:var(--pink-glow);color:var(--pink);"><i class="fas fa-thumbs-down"></i></div>
      <div class="stat-tile-label">Tổng lượt không thích</div>
      <div class="stat-tile-value"><%= (guildStats.totalSuggestionDownvotes || 0).toLocaleString('vi-VN') %></div>
    </div>
  </div>
</div>

<!-- Server stats -->
<div class="card">
  <div class="card-header">
    <div class="card-icon"><i class="fas fa-server"></i></div>
    <h2 class="card-title">Máy chủ</h2>
  </div>
  <div class="stat-grid">
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-users"></i></div>
      <div class="stat-tile-label">Thành viên</div>
      <div class="stat-tile-value"><%= (guild.memberCount || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-sitemap"></i></div>
      <div class="stat-tile-label">Kênh</div>
      <div class="stat-tile-value"><%= (guild.channels.cache.size || 0).toLocaleString('vi-VN') %></div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-icon"><i class="fas fa-id-badge"></i></div>
      <div class="stat-tile-label">Role</div>
      <div class="stat-tile-value"><%= (guild.roles.cache.size || 0).toLocaleString('vi-VN') %></div>
    </div>
  </div>
</div>

<%- include('partials/shell-close') %>
