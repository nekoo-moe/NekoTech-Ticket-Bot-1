<%
  pageTitle = 'Ticket #' + ticket.identifier;
  activePage = 'open-tickets';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<style>
.ticket-detail-grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: var(--sp-5);
  align-items: start;
}
.ticket-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: var(--sp-3);
  margin-bottom: var(--sp-5);
}
.meta-item {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: var(--sp-3);
}
.meta-item-label { font-size: 0.72rem; color: var(--ink-3); font-weight: 600; margin-bottom: 4px; }
.meta-item-value { font-size: 0.875rem; color: var(--ink-1); font-weight: 500; }

/* Messages */
.msg-list { display: flex; flex-direction: column; gap: var(--sp-3); }
.msg-item {
  display: flex;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  border-radius: var(--r-md);
  background: var(--surface-2);
  border: 1px solid var(--border);
}
.msg-avatar { width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--border); flex-shrink: 0; }
.msg-body { flex: 1; min-width: 0; }
.msg-header { display: flex; align-items: baseline; gap: var(--sp-2); margin-bottom: 4px; }
.msg-author { font-size: 0.875rem; font-weight: 600; color: var(--teal); }
.msg-time   { font-size: 0.72rem; color: var(--ink-3); }
.msg-text   { font-size: 0.875rem; color: var(--ink-2); line-height: 1.6; word-break: break-word; }
.msg-embed {
  margin-top: var(--sp-2);
  background: var(--surface-3);
  border-radius: var(--r-sm);
  border-left: 3px solid var(--teal);
  padding: var(--sp-2) var(--sp-3);
  font-size: 0.825rem;
}
.msg-embed-title { font-weight: 600; color: var(--ink-1); margin-bottom: 4px; }
.msg-embed-desc  { color: var(--ink-2); line-height: 1.5; }
.msg-attachment  { margin-top: var(--sp-2); }
.msg-attachment img { max-width: 100%; max-height: 300px; border-radius: var(--r-sm); }

/* Sidebar */
.ticket-sidebar { display: flex; flex-direction: column; gap: var(--sp-4); }

/* New message notice */
.new-msg-notice {
  display: none;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  background: var(--teal-glow);
  border: 1px solid var(--teal-border);
  border-radius: var(--r-md);
  margin-bottom: var(--sp-4);
  font-size: 0.875rem;
  color: var(--teal);
}
.new-msg-notice.visible { display: flex; }

/* Confirm dialog */
.confirm-dialog {
  position: fixed; inset: 0;
  background: oklch(0 0 0 / 0.7);
  z-index: var(--z-modal);
  display: none; place-items: center;
}
.confirm-dialog.open { display: grid; }
.confirm-box {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  max-width: 380px; width: calc(100% - var(--sp-6));
  display: flex; flex-direction: column; gap: var(--sp-4);
  animation: modal-in 200ms var(--ease-out) both;
}
@keyframes modal-in {
  from { opacity:0; transform: scale(0.96) translateY(8px); }
  to   { opacity:1; transform: scale(1) translateY(0); }
}
.confirm-title { font-size: 1rem; font-weight: 700; color: var(--ink-1); }
.confirm-body  { font-size: 0.875rem; color: var(--ink-3); }
.confirm-actions { display: flex; gap: var(--sp-3); justify-content: flex-end; }

@media (max-width: 900px) {
  .ticket-detail-grid { grid-template-columns: 1fr; }
  .ticket-sidebar { order: -1; }
}
</style>

<div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-5);">
  <a href="/open-tickets" class="btn btn-ghost btn-sm">
    <i class="fas fa-arrow-left"></i> Quay lại
  </a>
  <h1 class="page-title" style="margin:0;">Ticket <span style="color:var(--teal);">#<%= ticket.identifier %></span></h1>
  <span class="badge badge-teal" style="margin-left:auto;">Đang mở</span>
</div>

<!-- New message notice -->
<div class="new-msg-notice" id="newMsgNotice">
  <i class="fas fa-bell"></i>
  <span>Có tin nhắn mới trong ticket này.</span>
  <button class="btn btn-ghost btn-sm" onclick="location.reload()" style="margin-left:auto;">
    <i class="fas fa-rotate-right"></i> Tải lại
  </button>
  <button onclick="document.getElementById('newMsgNotice').classList.remove('visible')"
          style="background:none;border:none;cursor:pointer;color:var(--teal);padding:0;font-size:0.8rem;">
    <i class="fas fa-times"></i>
  </button>
</div>

<!-- Meta info -->
<div class="ticket-meta-grid">
  <div class="meta-item">
    <div class="meta-item-label">Người tạo</div>
    <div class="meta-item-value"><%= userInfo.username || 'Unknown' %></div>
  </div>
  <div class="meta-item">
    <div class="meta-item-label">Danh mục</div>
    <div class="meta-item-value"><%= ticket.ticketType || 'N/A' %></div>
  </div>
  <div class="meta-item">
    <div class="meta-item-label">Kênh</div>
    <div class="meta-item-value">#<%= ticket.channelName || 'unknown' %></div>
  </div>
  <div class="meta-item">
    <div class="meta-item-label">Thời gian mở</div>
    <div class="meta-item-value"><%= ticket.openDuration || 'N/A' %></div>
  </div>
  <div class="meta-item">
    <div class="meta-item-label">Ưu tiên</div>
    <div class="meta-item-value">
      <span class="badge <%= ticket.priority === 'High' ? 'badge-red' : ticket.priority === 'Medium' ? 'badge-pink' : 'badge-muted' %>">
        <%= ticket.priority || 'Bình thường' %>
      </span>
    </div>
  </div>
  <div class="meta-item">
    <div class="meta-item-label">Ngày tạo</div>
    <div class="meta-item-value"><%= new Date(ticket.createdAt).toLocaleDateString('vi-VN') %></div>
  </div>
</div>

<div class="ticket-detail-grid">
  <!-- Messages -->
  <div>
    <div class="card">
      <div class="card-header">
        <div class="card-icon"><i class="fas fa-comments"></i></div>
        <h2 class="card-title">Tin nhắn (<%= messages.length %>)</h2>
      </div>
      <% if (messages.length > 0) { %>
      <div class="msg-list">
        <% messages.slice().reverse().forEach(msg => { %>
        <div class="msg-item">
          <img src="<%= msg.avatar %>" alt="<%= msg.username %>" class="msg-avatar">
          <div class="msg-body">
            <div class="msg-header">
              <span class="msg-author"><%= msg.username %></span>
              <span class="msg-time"><%= new Date(msg.createdAt).toLocaleString('vi-VN', { dateStyle:'short', timeStyle:'short' }) %></span>
            </div>
            <% if (msg.content) { %>
              <div class="msg-text"><%= msg.content %></div>
            <% } %>
            <% if (msg.embeds && msg.embeds.length > 0) { %>
              <% msg.embeds.forEach(embed => { %>
              <div class="msg-embed">
                <% if (embed.title) { %><div class="msg-embed-title"><%= embed.title %></div><% } %>
                <% if (embed.description) { %><div class="msg-embed-desc"><%- embed.description %></div><% } %>
                <% if (embed.fields) { embed.fields.forEach(f => { %>
                  <div style="margin-top:6px;"><strong style="color:var(--ink-1);font-size:0.8rem;"><%= f.name %></strong><div class="msg-embed-desc"><%- f.value %></div></div>
                <% }); } %>
              </div>
              <% }); %>
            <% } %>
            <% if (msg.attachments && msg.attachments.length > 0) { %>
              <% msg.attachments.forEach(att => { %>
              <div class="msg-attachment">
                <% if (att.type && att.type.startsWith('image/')) { %>
                  <img src="<%= att.url %>" alt="<%= att.name %>">
                <% } else { %>
                  <a href="<%= att.url %>" target="_blank" class="btn btn-ghost btn-sm">
                    <i class="fas fa-download"></i> <%= att.name %>
                  </a>
                <% } %>
              </div>
              <% }); %>
            <% } %>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-comment-slash"></i></div>
        <p class="empty-title">Chưa có tin nhắn</p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="ticket-sidebar">
    <!-- Reply box -->
    <div class="card">
      <div class="card-header">
        <div class="card-icon"><i class="fas fa-reply"></i></div>
        <h3 class="card-title">Phản hồi</h3>
      </div>
      <div class="form-group">
        <textarea id="responseInput" class="form-textarea" rows="4"
                  placeholder="Nhập phản hồi..." maxlength="1999"></textarea>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:var(--sp-2);">
          <span id="charCount" style="font-size:0.72rem;color:var(--ink-3);">1999 ký tự còn lại</span>
          <button id="sendBtn" class="btn btn-primary btn-sm" onclick="sendResponse()">
            <i class="fas fa-paper-plane"></i> Gửi
          </button>
        </div>
      </div>
    </div>

    <!-- Close ticket -->
    <button class="btn btn-danger" style="width:100%;justify-content:center;" onclick="document.getElementById('closeDialog').classList.add('open')">
      <i class="fas fa-times-circle"></i> Đóng ticket
    </button>

    <!-- Questions -->
    <% if (ticket.questions && ticket.questions.length > 0) { %>
    <div class="card">
      <div class="card-header">
        <div class="card-icon"><i class="fas fa-question-circle"></i></div>
        <h3 class="card-title">Câu hỏi</h3>
      </div>
      <% ticket.questions.forEach(q => { %>
      <div style="margin-bottom:var(--sp-3);padding-bottom:var(--sp-3);border-bottom:1px solid var(--border);">
        <div style="font-size:0.75rem;color:var(--ink-3);margin-bottom:4px;"><%= q.question %></div>
        <div style="font-size:0.875rem;color:var(--ink-1);font-weight:500;"><%= q.response || 'Chưa trả lời' %></div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

<!-- Close confirm dialog -->
<div class="confirm-dialog" id="closeDialog">
  <div class="confirm-box">
    <h2 class="confirm-title">Đóng ticket này?</h2>
    <p class="confirm-body">Ticket sẽ được đóng và transcript sẽ được gửi cho người tạo. Hành động này không thể hoàn tác.</p>
    <div class="confirm-actions">
      <button class="btn btn-ghost" onclick="document.getElementById('closeDialog').classList.remove('open')">Hủy</button>
      <button class="btn btn-danger" id="confirmCloseBtn">
        <i class="fas fa-times-circle"></i> Đóng ticket
      </button>
    </div>
  </div>
</div>

<script>
// Char counter
const ta = document.getElementById('responseInput');
const cc = document.getElementById('charCount');
ta.addEventListener('input', () => { cc.textContent = (1999 - ta.value.length) + ' ký tự còn lại'; });

// Send response
async function sendResponse() {
  const msg = ta.value.trim();
  if (!msg) { showToast('Vui lòng nhập nội dung phản hồi.', 'error'); return; }
  const btn = document.getElementById('sendBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  try {
    const res = await fetch('/open-tickets/<%= ticket.identifier %>/respond', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg }),
    });
    if (res.ok) { location.reload(); }
    else { const d = await res.json(); showToast(d.error || 'Lỗi gửi phản hồi', 'error'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi'; }
  } catch { showToast('Lỗi kết nối', 'error'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi'; }
}

// Close ticket
document.getElementById('confirmCloseBtn').addEventListener('click', async () => {
  try {
    const res = await fetch('/open-tickets/<%= ticket.identifier %>/close', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    if (res.ok) { window.location.href = '/open-tickets'; }
    else { showToast('Lỗi đóng ticket', 'error'); }
  } catch { showToast('Lỗi kết nối', 'error'); }
});

// Close dialog on backdrop click
document.getElementById('closeDialog').addEventListener('click', e => {
  if (e.target === e.currentTarget) e.currentTarget.classList.remove('open');
});

// Poll for new messages
let lastId = null;
async function pollMessages() {
  try {
    const res = await fetch('/open-tickets/<%= ticket.identifier %>/messages');
    if (!res.ok) return;
    const msgs = await res.json();
    if (msgs.length > 0) {
      if (lastId && msgs[0].id !== lastId) document.getElementById('newMsgNotice').classList.add('visible');
      lastId = msgs[0].id;
    }
  } catch {}
}
pollMessages();
setInterval(pollMessages, 12000);
</script>

<%- include('partials/shell-close') %>
