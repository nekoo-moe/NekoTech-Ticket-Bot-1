<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập · Heiznerd Tickets</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <style>
    :root {
      --accent-color: <%= accentColorHex %>;
      --accent-color-rgb: <%= accentColorRgb %>;
    }
    body {
      display: grid;
      place-items: center;
      min-height: 100vh;
      background: var(--bg);
    }
    .login-wrap {
      width: 100%;
      max-width: 380px;
      padding: var(--sp-4);
    }
    .login-card {
      background: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      padding: var(--sp-7) var(--sp-6);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--sp-4);
    }
    .login-logo {
      width: 56px; height: 56px;
      background: var(--teal-glow);
      border: 1px solid var(--teal-border);
      border-radius: var(--r-lg);
      display: grid; place-items: center;
      color: var(--teal);
      font-size: 1.5rem;
    }
    .login-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--ink-1);
      letter-spacing: -0.02em;
    }
    .login-body {
      font-size: 0.875rem;
      color: var(--ink-3);
      max-width: 28ch;
      line-height: 1.5;
    }
    .btn-discord {
      background: #5865F2;
      color: #fff;
      font-weight: 600;
      padding: var(--sp-3) var(--sp-5);
      border-radius: var(--r-md);
      display: inline-flex;
      align-items: center;
      gap: var(--sp-3);
      font-size: 0.9rem;
      transition: background var(--dur-fast), transform var(--dur-fast);
      text-decoration: none;
      border: none;
      cursor: pointer;
    }
    .btn-discord:hover { background: #4752c4; transform: translateY(-1px); color: #fff; }
    .login-footer {
      font-size: 0.75rem;
      color: var(--ink-3);
    }
  </style>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-logo"><i class="fas fa-ticket-alt"></i></div>
      <h1 class="login-title">Heiznerd Tickets</h1>
      <p class="login-body">Đăng nhập bằng tài khoản Discord để truy cập bảng điều khiển.</p>
      <a href="/auth" class="btn-discord">
        <i class="fab fa-discord"></i>
        Đăng nhập với Discord
      </a>
      <p class="login-footer">Chỉ thành viên có quyền hỗ trợ mới có thể truy cập.</p>
    </div>
  </div>
</body>
</html>
