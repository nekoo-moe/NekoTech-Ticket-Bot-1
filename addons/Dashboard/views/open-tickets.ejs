<%
  pageTitle = 'Ticket đang mở';
  activePage = 'open-tickets';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage, openTicketsTotal }) %>

<div class="page-header">
  <h1 class="page-title">Ticket đang mở
    <% if (openTicketsTotal > 0) { %>
      <span class="badge badge-teal" style="font-size:0.9rem;vertical-align:middle;margin-left:var(--sp-2);"><%= openTicketsTotal %></span>
    <% } %>
  </h1>
  <p class="page-subtitle">Tất cả ticket đang chờ xử lý, nhóm theo danh mục.</p>
</div>

<% if (Object.keys(categorizedTickets).length > 0) { %>
  <% Object.keys(categorizedTickets).forEach(ticketType => { %>
  <div class="card" style="margin-bottom:var(--sp-4);">
    <div class="card-header">
      <div class="card-icon"><i class="fas fa-folder"></i></div>
      <h2 class="card-title"><%= ticketType %></h2>
      <span class="badge badge-muted" style="margin-left:auto;"><%= categorizedTickets[ticketType].length %> ticket</span>
    </div>

    <% categorizedTickets[ticketType].forEach(ticket => { %>
    <div class="ticket-row">
      <span class="ticket-id-badge">#<%= ticket.identifier %></span>
      <div class="ticket-user">
        <img src="<%= ticket.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
             alt="<%= ticket.username %>" class="ticket-avatar">
        <span class="ticket-username"><%= ticket.username || 'Unknown' %></span>
      </div>
      <div class="ticket-meta">
        <% if (ticket.priority) { %>
          <span class="badge <%= ticket.priority === 'High' ? 'badge-red' : ticket.priority === 'Medium' ? 'badge-pink' : 'badge-muted' %>">
            <i class="fas fa-flag" style="margin-right:3px;"></i><%= ticket.priority %>
          </span>
        <% } %>
        <span class="badge badge-muted"><i class="fas fa-comments" style="margin-right:4px;"></i><%= ticket.messages || 0 %></span>
        <span class="badge <%= ticket.waitingReplyFrom === 'staff' ? 'badge-pink' : 'badge-teal' %>">
          <i class="fas <%= ticket.waitingReplyFrom === 'staff' ? 'fa-user-shield' : 'fa-user' %>" style="margin-right:4px;"></i>
          <%= ticket.waitingReplyFrom === 'staff' ? 'Chờ staff' : 'Chờ user' %>
        </span>
        <span class="badge badge-muted">
          <i class="fas fa-calendar-alt" style="margin-right:4px;"></i>
          <%= new Date(ticket.createdAt).toLocaleDateString('vi-VN', { day:'2-digit', month:'short' }) %>
        </span>
        <% if (ticket.claimUser && ticket.claimUserInfo) { %>
          <span class="badge badge-muted">
            <i class="fas fa-hand-paper" style="margin-right:4px;"></i><%= ticket.claimUserInfo.username %>
          </span>
        <% } %>
      </div>
      <div class="ticket-actions">
        <a href="/open-tickets/<%= ticket.identifier %>" class="btn btn-ghost btn-sm">
          <i class="fas fa-arrow-up-right-from-square"></i> Xem
        </a>
      </div>
    </div>
    <% }); %>
  </div>
  <% }); %>
<% } else { %>
  <div class="card">
    <div class="empty-state">
      <div class="empty-icon"><i class="fas fa-inbox"></i></div>
      <p class="empty-title">Không có ticket nào đang mở</p>
      <p class="empty-body">Tất cả ticket đã được xử lý. Tốt lắm!</p>
    </div>
  </div>
<% } %>

<%- include('partials/shell-close') %>
