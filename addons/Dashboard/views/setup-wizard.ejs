<%
  pageTitle = 'Cài đặt';
  activePage = 'setup';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<style>
/* ── Wizard-specific styles ─────────────────────────────── */
.wizard-layout {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: var(--sp-5);
  align-items: start;
}

.wizard-nav {
  position: sticky;
  top: calc(56px + var(--sp-5));
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.wizard-nav-item {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--ink-3);
  cursor: pointer;
  transition: all var(--dur-fast);
  border: 1px solid transparent;
  text-decoration: none;
}
.wizard-nav-item:hover { background: var(--surface-2); color: var(--ink-1); }
.wizard-nav-item.active { background: var(--teal-glow); color: var(--teal); border-color: var(--teal-border); }
.wizard-nav-item.done { color: var(--success); }
.wizard-nav-item.done .wni-dot { background: var(--success); }

.wni-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--border);
  flex-shrink: 0;
  transition: background var(--dur-fast);
}
.wizard-nav-item.active .wni-dot { background: var(--teal); }

.wizard-content { min-width: 0; }

/* Section panels */
.setup-section {
  display: none;
}
.setup-section.active { display: block; }

/* Section header */
.section-head {
  margin-bottom: var(--sp-5);
  padding-bottom: var(--sp-4);
  border-bottom: 1px solid var(--border);
}
.section-head h2 {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--ink-1);
  letter-spacing: -0.02em;
}
.section-head p {
  font-size: 0.85rem;
  color: var(--ink-3);
  margin-top: var(--sp-1);
}

/* Form grid */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-4);
}
.form-grid.single { grid-template-columns: 1fr; }
.form-grid.triple { grid-template-columns: 1fr 1fr 1fr; }
.span-2 { grid-column: span 2; }

/* Category list */
.category-list { display: flex; flex-direction: column; gap: var(--sp-3); }
.category-item {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: var(--sp-3) var(--sp-4);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.category-item-name { font-weight: 600; color: var(--ink-1); font-size: 0.875rem; }
.category-item-key  { font-size: 0.75rem; color: var(--ink-3); font-family: monospace; }
.category-item-actions { margin-left: auto; display: flex; gap: var(--sp-2); }

/* Discord embed preview */
.preview-panel {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  margin-top: var(--sp-4);
}
.preview-label {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: var(--sp-3);
}
.discord-preview {
  background: #313338;
  border-radius: 8px;
  padding: 16px;
  font-family: 'gg sans', 'Noto Sans', system-ui, sans-serif;
}
.discord-embed {
  display: flex;
  border-radius: 4px;
  overflow: hidden;
  background: #2b2d31;
  max-width: 520px;
}
.embed-accent-bar {
  width: 4px;
  flex-shrink: 0;
  background: var(--preview-color, #59d4b5);
}
.embed-body {
  padding: 12px 16px 12px 12px;
  flex: 1;
  min-width: 0;
}
.embed-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6px;
  word-break: break-word;
}
.embed-description {
  font-size: 0.825rem;
  color: #dbdee1;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}
.embed-footer {
  font-size: 0.72rem;
  color: #949ba4;
  margin-top: 8px;
}
.discord-buttons {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  flex-wrap: wrap;
}
.discord-btn {
  padding: 5px 16px;
  border-radius: 3px;
  font-size: 0.825rem;
  font-weight: 500;
  cursor: default;
}
.discord-btn.green  { background: #248046; color: #fff; }
.discord-btn.red    { background: #da373c; color: #fff; }
.discord-btn.gray   { background: #4e5058; color: #fff; }
.discord-btn.blurple{ background: #5865f2; color: #fff; }

/* Color picker row */
.color-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.color-swatch {
  width: 36px; height: 36px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  cursor: pointer;
  flex-shrink: 0;
}

/* Save bar */
.save-bar {
  position: sticky;
  bottom: 0;
  background: var(--surface-1);
  border-top: 1px solid var(--border);
  padding: var(--sp-3) var(--sp-5);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin: var(--sp-5) calc(-1 * var(--sp-6)) 0;
  z-index: var(--z-sticky);
}
.save-status { font-size: 0.8rem; color: var(--ink-3); }

/* Working hours table */
.wh-table { width: 100%; border-collapse: collapse; }
.wh-table th {
  font-size: 0.75rem; font-weight: 600; color: var(--ink-3);
  padding: var(--sp-2) var(--sp-3); text-align: left;
  border-bottom: 1px solid var(--border);
}
.wh-table td {
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1px solid var(--border);
  font-size: 0.875rem;
  vertical-align: middle;
}
.wh-table tr:last-child td { border-bottom: none; }

@media (max-width: 900px) {
  .wizard-layout { grid-template-columns: 1fr; }
  .wizard-nav { position: static; flex-direction: row; flex-wrap: wrap; }
  .form-grid { grid-template-columns: 1fr; }
  .span-2 { grid-column: span 1; }
}
</style>

<div class="page-header" style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--sp-4);">
  <div>
    <h1 class="page-title">Cài đặt bot</h1>
    <p class="page-subtitle">Cấu hình toàn bộ Heiznerd Tickets cho máy chủ của bạn.</p>
  </div>
  <button class="btn btn-danger btn-sm" style="flex-shrink:0;margin-top:4px;" onclick="resetAllConfig()">
    <i class="fas fa-trash-alt"></i> Reset toàn bộ config
  </button>
</div>

<script>
async function resetAllConfig() {
  if (!confirm('⚠️ Reset toàn bộ cấu hình?\n\nHành động này sẽ xóa tất cả cài đặt đã lưu và không thể hoàn tác.')) return;
  try {
    const res  = await fetch('/api/setup/reset-config', { method: 'POST' });
    const data = await res.json();
    if (data.success) { showToast('Đã reset toàn bộ cấu hình', 'success'); setTimeout(() => location.reload(), 1000); }
    else showToast(data.error || 'Lỗi reset', 'error');
  } catch { showToast('Lỗi kết nối', 'error'); }
}
</script>

<div class="wizard-layout">
  <!-- Left nav -->
  <nav class="wizard-nav" aria-label="Mục cài đặt">
    <a class="wizard-nav-item active" data-section="ticket" href="#ticket">
      <span class="wni-dot"></span>Ticket cơ bản
    </a>
    <a class="wizard-nav-item" data-section="category" href="#category">
      <span class="wni-dot"></span>Danh mục &amp; Panel
    </a>
    <a class="wizard-nav-item" data-section="transcript" href="#transcript">
      <span class="wni-dot"></span>Transcript
    </a>
    <a class="wizard-nav-item" data-section="claiming" href="#claiming">
      <span class="wni-dot"></span>Claiming
    </a>
    <a class="wizard-nav-item" data-section="alert" href="#alert">
      <span class="wni-dot"></span>Cảnh báo
    </a>
    <a class="wizard-nav-item" data-section="workinghours" href="#workinghours">
      <span class="wni-dot"></span>Giờ làm việc
    </a>
    <a class="wizard-nav-item" data-section="review" href="#review">
      <span class="wni-dot"></span>Đánh giá
    </a>
    <a class="wizard-nav-item" data-section="suggestion" href="#suggestion">
      <span class="wni-dot"></span>Đề xuất
    </a>
    <a class="wizard-nav-item" data-section="priority" href="#priority">
      <span class="wni-dot"></span>Độ ưu tiên
    </a>
    <a class="wizard-nav-item" data-section="channelstats" href="#channelstats">
      <span class="wni-dot"></span>Kênh thống kê
    </a>
    <a class="wizard-nav-item" data-section="archive" href="#archive">
      <span class="wni-dot"></span>Lưu trữ
    </a>
    <a class="wizard-nav-item" data-section="vietqr" href="#vietqr">
      <span class="wni-dot"></span>VietQR
    </a>
  </nav>

  <!-- Right content -->
  <div class="wizard-content">

    <!-- ── TICKET CƠ BẢN ─────────────────────────────────── -->
    <div class="setup-section active" id="section-ticket">
      <div class="section-head">
        <h2>Ticket cơ bản</h2>
        <p>Cài đặt chung cho hệ thống ticket: kênh log, giới hạn, màu sắc và role staff.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="logsChannel">Kênh log mặc định</label>
          <input type="text" id="logsChannel" class="form-input" placeholder="ID kênh Discord"
                 value="<%= cfg['ticket.logsChannelID'] || '' %>">
          <span class="form-hint">ID kênh text để ghi log tất cả ticket.</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="maxTickets">Số ticket tối đa / người</label>
          <input type="number" id="maxTickets" class="form-input" min="1" max="10"
                 value="<%= cfg['ticket.maxTickets'] || 1 %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="deleteTime">Thời gian xóa sau khi đóng (giây)</label>
          <input type="number" id="deleteTime" class="form-input" min="0" max="60"
                 value="<%= cfg['ticket.deleteTime'] || 5 %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="cooldown">Cooldown tạo ticket (giây, 0 = tắt)</label>
          <input type="number" id="cooldown" class="form-input" min="0"
                 value="<%= cfg['ticket.cooldown'] || 0 %>">
        </div>
        <div class="form-group">
          <label class="form-label">Staff roles</label>
          <div id="staffRolesContainer" style="display:flex;flex-wrap:wrap;gap:6px;padding:8px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);min-height:42px;align-items:center;">
            <% (cfg['staffRoles'] || []).forEach(roleId => { %>
            <span class="staff-role-tag" data-id="<%= roleId %>" style="display:inline-flex;align-items:center;gap:4px;background:var(--teal-glow);color:var(--teal);border:1px solid var(--teal-border);border-radius:4px;padding:2px 8px;font-size:0.8rem;font-weight:500;">
              <i class="fas fa-shield-alt" style="font-size:0.7rem;"></i>
              <span class="role-name"><%= roleId %></span>
              <button type="button" onclick="removeStaffRole('<%= roleId %>')" style="background:none;border:none;cursor:pointer;color:var(--teal);padding:0;margin-left:2px;font-size:0.75rem;line-height:1;">×</button>
            </span>
            <% }); %>
          </div>
          <div style="display:flex;gap:8px;margin-top:8px;">
            <input type="text" id="staffRoleInput" class="form-input" placeholder="Nhập Role ID rồi nhấn Thêm..."
                   style="flex:1;" onkeydown="if(event.key==='Enter'){event.preventDefault();addStaffRole();}">
            <button type="button" class="btn btn-secondary btn-sm" onclick="addStaffRole()" style="white-space:nowrap;">
              <i class="fas fa-plus"></i> Thêm
            </button>
          </div>
          <input type="hidden" id="staffRoles" value="<%= (cfg['staffRoles'] || []).join(',') %>">
          <span class="form-hint">Thêm từng Role ID một. Nhấn × để xóa.</span>
        </div>
        <div class="form-group span-2">
          <label class="form-label" for="channelTopic">Chủ đề kênh ticket</label>
          <input type="text" id="channelTopic" class="form-input"
                 placeholder="Người tạo: {username} | Danh mục: {category}"
                 value="<%= cfg['ticket.channelTopic'] || 'Người tạo: {username} | Danh mục: {category}' %>">
          <span class="form-hint">Biến: {username}, {category}</span>
        </div>
      </div>

      <!-- Toggles -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="mentionAuthor" <%= cfg['ticket.mentionAuthor'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Mention người tạo khi mở ticket</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="restrictClose" <%= cfg['ticket.restrictClose'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Chỉ staff mới được đóng ticket</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="closeReason" <%= cfg['ticket.closeReason'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Yêu cầu lý do khi đóng</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="selectMenu" <%= cfg['ticket.selectMenu'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Dùng dropdown thay vì nút</span>
        </label>
      </div>

      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('ticket')">
          <i class="fas fa-save"></i> Lưu cài đặt ticket
        </button>
        <span class="save-status" id="save-status-ticket"></span>
      </div>
    </div>

    <!-- ── DANH MỤC ──────────────────────────────────────── -->
    <!-- ── DANH MỤC & PANEL ─────────────────────────────── -->
    <div class="setup-section" id="section-category">
      <div class="section-head">
        <h2>Danh mục &amp; Panel</h2>
        <p>Quy trình 3 bước: tạo danh mục → thiết kế panel → gửi lên Discord.</p>
      </div>

      <!-- ── BƯỚC 1: DANH SÁCH DANH MỤC ──────────────────── -->
      <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-3);">
        <div style="width:28px;height:28px;background:var(--teal);border-radius:50%;display:grid;place-items:center;font-size:0.8rem;font-weight:700;color:#0d1117;flex-shrink:0;">1</div>
        <div>
          <div style="font-weight:600;color:var(--ink-1);">Danh mục ticket</div>
          <div style="font-size:0.8rem;color:var(--ink-3);">Mỗi danh mục = một loại ticket riêng với embed, role hỗ trợ và kênh riêng</div>
        </div>
      </div>

      <div id="catCardList" style="display:flex;flex-direction:column;gap:var(--sp-2);margin-bottom:var(--sp-4);">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
          <div class="cat-card" data-key="<%= cat.categoryKey %>">
            <!-- Collapsed row -->
            <div class="cat-card-row" onclick="toggleCatCard('<%= cat.categoryKey %>')" style="display:flex;align-items:center;gap:var(--sp-3);padding:var(--sp-3) var(--sp-4);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);cursor:pointer;transition:border-color var(--dur-fast);">
              <span style="font-size:1.1rem;"><%= cat.categoryEmoji || '🎫' %></span>
              <div style="flex:1;">
                <div style="font-weight:600;color:var(--ink-1);font-size:0.875rem;"><%= cat.categoryName %></div>
                <div style="font-size:0.75rem;color:var(--ink-3);font-family:monospace;"><%= cat.categoryKey %></div>
              </div>
              <span class="badge badge-muted" style="margin-left:auto;"><%= (cat.supportRoles||[]).length %> role</span>
              <i class="fas fa-chevron-down cat-chevron" style="font-size:0.7rem;color:var(--ink-3);transition:transform var(--dur-fast);"></i>
              <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();deleteCategory('<%= cat.categoryKey %>')" title="Xóa"><i class="fas fa-trash"></i></button>
            </div>
            <!-- Expanded edit form -->
            <div class="cat-edit-body" id="cat-edit-<%= cat.categoryKey %>" style="display:none;border:1px solid var(--teal-border);border-top:none;border-radius:0 0 var(--r-md) var(--r-md);padding:var(--sp-4);background:var(--surface-1);">
              <div class="form-grid">
                <div class="form-group">
                  <label class="form-label">Tên hiển thị</label>
                  <input type="text" class="form-input ec-name" value="<%= cat.categoryName %>" oninput="updateCatCardPreview('<%= cat.categoryKey %>')">
                </div>
                <div class="form-group">
                  <label class="form-label">Emoji</label>
                  <input type="text" class="form-input ec-emoji" value="<%= cat.categoryEmoji||'' %>" oninput="updateCatCardPreview('<%= cat.categoryKey %>')">
                </div>
                <div class="form-group">
                  <label class="form-label">Discord Category ID</label>
                  <input type="text" class="form-input ec-parent" value="<%= cat.parentCategoryID %>" placeholder="123456789012345678">
                </div>
                <div class="form-group">
                  <label class="form-label">Support Role IDs <span style="color:var(--ink-3);font-weight:400;">(phân cách bằng dấu phẩy)</span></label>
                  <input type="text" class="form-input ec-roles" value="<%= (cat.supportRoles||[]).join(', ') %>" placeholder="ID1, ID2">
                </div>
                <div class="form-group">
                  <label class="form-label">Kênh log riêng (ID, tùy chọn)</label>
                  <input type="text" class="form-input ec-logs" value="<%= cat.logsChannelID||'' %>">
                </div>
                <div class="form-group">
                  <label class="form-label">Tên kênh ticket</label>
                  <input type="text" class="form-input ec-chname" value="<%= cat.channelName||'ticket-{username}' %>">
                  <span class="form-hint">{username} {user-id} {total-tickets}</span>
                </div>
                <div class="form-group">
                  <label class="form-label">Màu nút</label>
                  <select class="form-select ec-color" onchange="updateCatCardPreview('<%= cat.categoryKey %>')">
                    <option value="Green"   <%= cat.buttonColor==='Green'   ?'selected':'' %>>🟢 Xanh lá</option>
                    <option value="Blurple" <%= cat.buttonColor==='Blurple' ?'selected':'' %>>🔵 Xanh dương</option>
                    <option value="Gray"    <%= cat.buttonColor==='Gray'    ?'selected':'' %>>⚫ Xám</option>
                    <option value="Red"     <%= cat.buttonColor==='Red'     ?'selected':'' %>>🔴 Đỏ</option>
                  </select>
                </div>
                <div class="form-group" style="display:flex;align-items:flex-end;">
                  <label class="form-toggle">
                    <input type="checkbox" class="ec-mention" <%= cat.mentionSupportRoles?'checked':'' %>>
                    <span class="toggle-track"></span>
                    <span style="font-size:0.875rem;color:var(--ink-2);">Mention role khi tạo</span>
                  </label>
                </div>
                <div class="form-group span-2">
                  <label class="form-label">Tiêu đề embed khi mở ticket</label>
                  <input type="text" class="form-input ec-title" value="<%= cat.embedTitle||'' %>" placeholder="Ticket {category}" oninput="updateCatCardPreview('<%= cat.categoryKey %>')">
                  <span class="form-hint">{category}</span>
                </div>
                <div class="form-group span-2">
                  <label class="form-label">Nội dung embed</label>
                  <textarea class="form-textarea ec-msg" rows="3" oninput="updateCatCardPreview('<%= cat.categoryKey %>')" placeholder="> Cảm ơn bạn đã liên hệ."><%= cat.embedMessage||'' %></textarea>
                  <span class="form-hint">{user} {createdAt}</span>
                </div>
                <div class="form-group">
                  <label class="form-label">Thumbnail URL embed (tùy chọn)</label>
                  <input type="url" class="form-input ec-thumbnail" value="<%= cat.embedThumbnailURL||'' %>" placeholder="https://i.imgur.com/example.png">
                  <span class="form-hint">Ảnh nhỏ góc phải embed khi mở ticket</span>
                </div>
                <div class="form-group">
                  <label class="form-label">Banner URL embed (tùy chọn)</label>
                  <input type="url" class="form-input ec-image" value="<%= cat.embedImageURL||'' %>" placeholder="https://i.imgur.com/banner.gif">
                  <span class="form-hint">Ảnh lớn dưới embed, hỗ trợ GIF</span>
                </div>
                <div class="form-group">
                  <label class="form-label">Footer text</label>
                  <input type="text" class="form-input ec-footer-text" value="<%= cat.embedFooterText||'' %>" placeholder="Heiznerd Support">
                </div>
                <div class="form-group">
                  <label class="form-label">Footer icon URL</label>
                  <input type="url" class="form-input ec-footer-icon" value="<%= cat.embedFooterIconURL||'' %>" placeholder="https://i.imgur.com/icon.png">
                </div>
                <div class="form-group span-2" style="background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-3);">
                  <div style="font-size:0.8rem;font-weight:600;color:var(--ink-2);margin-bottom:var(--sp-3);">📩 DM người dùng khi đóng ticket</div>
                  <label class="form-toggle" style="margin-bottom:var(--sp-3);">
                    <input type="checkbox" class="ec-dm-enabled" <%= cat.dmOnClose ? 'checked' : '' %>>
                    <span class="toggle-track"></span>
                    <span style="font-size:0.875rem;color:var(--ink-2);">Gửi DM khi ticket bị đóng</span>
                  </label>
                  <div class="form-group">
                    <label class="form-label">Nội dung DM</label>
                    <textarea class="form-textarea ec-dm-msg" rows="2" placeholder="Ticket {ticketType} của bạn đã được đóng. Lý do: {close-reason}"><%= cat.dmCloseMessage||'' %></textarea>
                    <span class="form-hint">{guildName} {closedAt} {close-reason} {ticketType}</span>
                  </div>
                </div>
              </div>

              <!-- Questions builder -->
              <div style="margin-top:var(--sp-4);background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-3);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-3);">
                  <div style="font-size:0.8rem;font-weight:600;color:var(--ink-2);">📋 Form câu hỏi khi tạo ticket <span style="color:var(--ink-3);font-weight:400;">(tối đa 5)</span></div>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="addQuestion('<%= cat.categoryKey %>')"><i class="fas fa-plus"></i> Thêm câu hỏi</button>
                </div>
                <div id="questions-<%= cat.categoryKey %>" style="display:flex;flex-direction:column;gap:var(--sp-2);">
                  <% (cat.questions||[]).forEach((q,qi) => { %>
                  <div class="question-row" style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-sm);padding:var(--sp-3);display:grid;grid-template-columns:1fr 1fr auto;gap:var(--sp-2);align-items:start;">
                    <div class="form-group">
                      <label class="form-label">Câu hỏi</label>
                      <input type="text" class="form-input q-label" value="<%= q.question||'' %>" placeholder="Bạn đang gặp vấn đề gì?">
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-2);">
                      <div class="form-group">
                        <label class="form-label">Kiểu nhập</label>
                        <select class="form-select q-style">
                          <option value="Short" <%= q.style==='Short'?'selected':'' %>>Ngắn</option>
                          <option value="Paragraph" <%= q.style==='Paragraph'?'selected':'' %>>Dài</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label class="form-label">Bắt buộc</label>
                        <select class="form-select q-required">
                          <option value="true" <%= q.required?'selected':'' %>>Có</option>
                          <option value="false" <%= !q.required?'selected':'' %>>Không</option>
                        </select>
                      </div>
                      <div class="form-group" style="grid-column:span 2;">
                        <label class="form-label">Placeholder</label>
                        <input type="text" class="form-input q-placeholder" value="<%= q.placeholder||'' %>" placeholder="Mô tả chi tiết...">
                      </div>
                    </div>
                    <button type="button" class="btn btn-danger btn-sm" style="margin-top:20px;" onclick="this.closest('.question-row').remove()"><i class="fas fa-trash"></i></button>
                  </div>
                  <% }); %>
                </div>
              </div>

              <!-- Live preview inside edit card -->
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
                <div>
                  <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);margin-bottom:var(--sp-2);">Embed trong ticket</div>
                  <div style="background:#313338;border-radius:8px;padding:12px;">
                    <div style="display:flex;border-radius:4px;overflow:hidden;background:#2b2d31;">
                      <div class="ec-prev-bar" id="ec-bar-<%= cat.categoryKey %>" style="width:4px;flex-shrink:0;background:<%= cfg['bot.embedColor']||'#59d4b5' %>;"></div>
                      <div style="padding:10px 14px 10px 10px;flex:1;">
                        <div class="ec-prev-title" id="ec-title-<%= cat.categoryKey %>" style="font-size:0.875rem;font-weight:600;color:#fff;margin-bottom:4px;"><%= cat.embedTitle||cat.categoryName %></div>
                        <div class="ec-prev-desc" id="ec-desc-<%= cat.categoryKey %>" style="font-size:0.8rem;color:#dbdee1;white-space:pre-wrap;margin-bottom:8px;"><%= cat.embedMessage||'' %></div>
                        <div style="background:#1e1f22;border-radius:4px;padding:8px 10px;margin-bottom:8px;font-size:0.75rem;color:#dbdee1;">
                          <div style="font-weight:700;color:#fff;margin-bottom:4px;">`🎫` Thông tin ticket</div>
                          <div style="color:#b5bac1;line-height:1.6;">
                            &gt; <strong>ID:</strong> <code>#AB1234</code><br>
                            &gt; <strong>Danh mục:</strong> <code id="ec-prev-catname-<%= cat.categoryKey %>"><%= cat.categoryName %></code><br>
                            &gt; <strong>Tạo lúc:</strong> hôm nay lúc ...<br>
                            &gt; <strong>Người tạo:</strong> @user<br>
                            &gt; <strong>Ticket thứ:</strong> <code>#47</code>
                          </div>
                        </div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap;">
                          <span style="background:#da373c;color:#fff;padding:4px 12px;border-radius:3px;font-size:0.8rem;">🔒 Đóng</span>
                          <span style="background:#4e5058;color:#fff;padding:4px 12px;border-radius:3px;font-size:0.8rem;">👋 Nhận</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div>
                  <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);margin-bottom:var(--sp-2);">Nút trên panel</div>
                  <div style="background:#313338;border-radius:8px;padding:12px;">
                    <button class="ec-prev-btn" id="ec-btn-<%= cat.categoryKey %>" style="border:none;cursor:default;padding:6px 16px;border-radius:3px;font-size:0.875rem;font-weight:500;background:#248046;color:#fff;">
                      <%= cat.categoryEmoji?cat.categoryEmoji+' ':'' %><%= cat.categoryName %>
                    </button>
                  </div>
                </div>
              </div>

              <div style="display:flex;gap:var(--sp-3);margin-top:var(--sp-4);">
                <button class="btn btn-primary btn-sm" onclick="saveCatCard('<%= cat.categoryKey %>')"><i class="fas fa-save"></i> Lưu</button>
                <button class="btn btn-ghost btn-sm" onclick="toggleCatCard('<%= cat.categoryKey %>')">Đóng</button>
              </div>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state" style="padding:var(--sp-5) 0;border:1px dashed var(--border);border-radius:var(--r-md);">
            <div class="empty-icon"><i class="fas fa-folder-plus"></i></div>
            <p class="empty-title">Chưa có danh mục nào</p>
            <p class="empty-body">Tạo danh mục đầu tiên bên dưới để bắt đầu.</p>
          </div>
        <% } %>
      </div>
      <!-- ── BƯỚC 2: TẠO DANH MỤC MỚI ──────────────────── -->
      <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-3);">
        <div style="width:28px;height:28px;background:var(--surface-3);border:1px solid var(--border);border-radius:50%;display:grid;place-items:center;font-size:0.8rem;font-weight:700;color:var(--ink-3);flex-shrink:0;">2</div>
        <div>
          <div style="font-weight:600;color:var(--ink-1);">Tạo danh mục mới</div>
          <div style="font-size:0.8rem;color:var(--ink-3);">Điền thông tin rồi xem trước trực tiếp trước khi lưu</div>
        </div>
      </div>

      <div class="card" style="margin-bottom:var(--sp-5);">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-5);">
          <!-- Left: inputs -->
          <div style="display:flex;flex-direction:column;gap:var(--sp-4);">
            <div class="form-group">
              <label class="form-label">Key <span style="color:var(--ink-3);font-weight:400;">(chữ thường, gạch ngang, không dấu)</span></label>
              <input type="text" id="newCatKey" class="form-input" placeholder="ho-tro-ky-thuat">
            </div>
            <div style="display:grid;grid-template-columns:1fr 80px;gap:var(--sp-3);">
              <div class="form-group">
                <label class="form-label">Tên hiển thị</label>
                <input type="text" id="newCatName" class="form-input" placeholder="Hỗ Trợ Kỹ Thuật" oninput="refreshNewCatPreview()">
              </div>
              <div class="form-group">
                <label class="form-label">Emoji</label>
                <input type="text" id="newCatEmoji" class="form-input" placeholder="🎫" oninput="refreshNewCatPreview()">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Discord Category ID <span style="color:var(--danger);font-size:0.75rem;">*bắt buộc</span></label>
              <input type="text" id="newCatParent" class="form-input" placeholder="ID category channel chứa các ticket">
            </div>
            <div class="form-group">
              <label class="form-label">Support Role IDs <span style="color:var(--danger);font-size:0.75rem;">*bắt buộc</span> <span style="color:var(--ink-3);font-weight:400;">(phân cách bằng dấu phẩy)</span></label>
              <input type="text" id="newCatRoles" class="form-input" placeholder="123456789, 987654321">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);">
              <div class="form-group">
                <label class="form-label">Kênh log riêng (tùy chọn)</label>
                <input type="text" id="newCatLogs" class="form-input" placeholder="ID kênh">
              </div>
              <div class="form-group">
                <label class="form-label">Tên kênh ticket</label>
                <input type="text" id="newCatChName" class="form-input" value="ticket-{username}">
                <span class="form-hint">{username} {user-id}</span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Tiêu đề embed khi mở ticket</label>
              <input type="text" id="newCatTitle" class="form-input" placeholder="Ticket {category}" oninput="refreshNewCatPreview()">
              <span class="form-hint">{category}</span>
            </div>
            <div class="form-group">
              <label class="form-label">Nội dung embed</label>
              <textarea id="newCatMsg" class="form-textarea" rows="3" placeholder="> Cảm ơn bạn đã liên hệ.&#10;> Mô tả vấn đề và chờ nhân viên hỗ trợ." oninput="refreshNewCatPreview()"></textarea>
              <span class="form-hint">{user} {createdAt}</span>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);">
              <div class="form-group">
                <label class="form-label">Thumbnail URL (tùy chọn)</label>
                <input type="url" id="newCatThumbnail" class="form-input" placeholder="https://i.imgur.com/example.png">
              </div>
              <div class="form-group">
                <label class="form-label">Banner/GIF URL (tùy chọn)</label>
                <input type="url" id="newCatImage" class="form-input" placeholder="https://i.imgur.com/banner.gif">
              </div>
              <div class="form-group">
                <label class="form-label">Footer text</label>
                <input type="text" id="newCatFooterText" class="form-input" placeholder="Heiznerd Support">
              </div>
              <div class="form-group">
                <label class="form-label">Footer icon URL</label>
                <input type="url" id="newCatFooterIcon" class="form-input" placeholder="https://i.imgur.com/icon.png">
              </div>
            </div>
            <div style="background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-3);">
              <div style="font-size:0.8rem;font-weight:600;color:var(--ink-2);margin-bottom:var(--sp-3);">📩 DM người dùng khi đóng ticket</div>
              <label class="form-toggle" style="margin-bottom:var(--sp-3);">
                <input type="checkbox" id="newCatDmEnabled">
                <span class="toggle-track"></span>
                <span style="font-size:0.875rem;color:var(--ink-2);">Gửi DM khi ticket bị đóng</span>
              </label>
              <div class="form-group">
                <label class="form-label">Nội dung DM</label>
                <textarea id="newCatDmMsg" class="form-textarea" rows="2" placeholder="Ticket {ticketType} của bạn đã được đóng. Lý do: {close-reason}"></textarea>
                <span class="form-hint">{guildName} {closedAt} {close-reason} {ticketType}</span>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);">
              <div class="form-group">
                <label class="form-label">Màu nút</label>
                <select id="newCatColor" class="form-select" onchange="refreshNewCatPreview()">
                  <option value="Green">🟢 Xanh lá</option>
                  <option value="Blurple">🔵 Xanh dương</option>
                  <option value="Gray">⚫ Xám</option>
                  <option value="Red">🔴 Đỏ</option>
                </select>
              </div>
              <div class="form-group" style="display:flex;align-items:flex-end;">
                <label class="form-toggle">
                  <input type="checkbox" id="newCatMention">
                  <span class="toggle-track"></span>
                  <span style="font-size:0.875rem;color:var(--ink-2);">Mention role khi tạo</span>
                </label>
              </div>
            </div>
            <!-- Questions builder -->
            <div style="background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-3);margin-top:var(--sp-2);">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-3);">
                <div style="font-size:0.8rem;font-weight:600;color:var(--ink-2);">📋 Form câu hỏi khi tạo ticket <span style="color:var(--ink-3);font-weight:400;">(tối đa 5)</span></div>
                <button type="button" class="btn btn-secondary btn-sm" onclick="addQuestion('new')"><i class="fas fa-plus"></i> Thêm câu hỏi</button>
              </div>
              <div id="questions-new" style="display:flex;flex-direction:column;gap:var(--sp-2);">
                <!-- default question pre-filled -->
                <div class="question-row" style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-sm);padding:var(--sp-3);display:grid;grid-template-columns:1fr 1fr auto;gap:var(--sp-2);align-items:start;">
                  <div class="form-group">
                    <label class="form-label">Câu hỏi</label>
                    <input type="text" class="form-input q-label" value="Bạn đang gặp phải vấn đề gì?" placeholder="Bạn đang gặp vấn đề gì?">
                  </div>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-2);">
                    <div class="form-group">
                      <label class="form-label">Kiểu nhập</label>
                      <select class="form-select q-style">
                        <option value="Short">Ngắn</option>
                        <option value="Paragraph" selected>Dài</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label class="form-label">Bắt buộc</label>
                      <select class="form-select q-required">
                        <option value="true" selected>Có</option>
                        <option value="false">Không</option>
                      </select>
                    </div>
                    <div class="form-group" style="grid-column:span 2;">
                      <label class="form-label">Placeholder</label>
                      <input type="text" class="form-input q-placeholder" value="Hãy miêu tả vấn đề của bạn càng chi tiết càng tốt nhé!" placeholder="Mô tả chi tiết...">
                    </div>
                  </div>
                  <button type="button" class="btn btn-danger btn-sm" style="margin-top:20px;" onclick="this.closest('.question-row').remove()"><i class="fas fa-trash"></i></button>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: live preview -->
          <div style="position:sticky;top:80px;align-self:start;">
            <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);margin-bottom:var(--sp-3);">Xem trước trực tiếp</div>
            <div style="background:#313338;border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:16px;">
              <!-- Embed preview -->
              <div>
                <div style="font-size:0.68rem;color:#949ba4;margin-bottom:6px;">📩 Embed trong kênh ticket</div>
                <div style="display:flex;border-radius:4px;overflow:hidden;background:#2b2d31;">
                  <div id="newCatPrevBar" style="width:4px;flex-shrink:0;background:<%= cfg['bot.embedColor']||'#59d4b5' %>;"></div>
                  <div style="padding:10px 14px 10px 10px;flex:1;min-width:0;">
                    <div id="newCatPrevTitle" style="font-size:0.875rem;font-weight:600;color:#fff;margin-bottom:4px;">Ticket Hỗ Trợ</div>
                    <div id="newCatPrevDesc" style="font-size:0.8rem;color:#dbdee1;white-space:pre-wrap;margin-bottom:8px;">&gt; Cảm ơn bạn đã liên hệ.</div>
                    <div style="background:#1e1f22;border-radius:4px;padding:8px 10px;margin-bottom:8px;font-size:0.75rem;color:#dbdee1;">
                      <div style="font-weight:700;color:#fff;margin-bottom:4px;">`🎫` Thông tin ticket</div>
                      <div style="color:#b5bac1;line-height:1.6;">
                        &gt; <strong>ID:</strong> <code>#AB1234</code><br>
                        &gt; <strong>Danh mục:</strong> <code id="newCatPrevCatName">Hỗ Trợ</code><br>
                        &gt; <strong>Tạo lúc:</strong> hôm nay lúc ...<br>
                        &gt; <strong>Người tạo:</strong> @user<br>
                        &gt; <strong>Ticket thứ:</strong> <code>#47</code>
                      </div>
                    </div>
                    <div style="display:flex;gap:6px;">
                      <span style="background:#da373c;color:#fff;padding:4px 12px;border-radius:3px;font-size:0.8rem;">🔒 Đóng</span>
                      <span style="background:#4e5058;color:#fff;padding:4px 12px;border-radius:3px;font-size:0.8rem;">👋 Nhận</span>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Panel button preview -->
              <div>
                <div style="font-size:0.68rem;color:#949ba4;margin-bottom:6px;">🗂️ Nút/dropdown trên panel</div>
                <button id="newCatPrevBtn" style="border:none;cursor:default;padding:6px 16px;border-radius:3px;font-size:0.875rem;font-weight:500;background:#248046;color:#fff;">🎫 Hỗ Trợ</button>
              </div>
            </div>
            <button class="btn btn-primary" style="width:100%;margin-top:var(--sp-4);" onclick="createNewCategory()">
              <i class="fas fa-plus"></i> Tạo danh mục
            </button>
            <span class="save-status" id="save-status-newcat" style="display:block;text-align:center;margin-top:var(--sp-2);"></span>
          </div>
        </div>
      </div>
      <!-- ── BƯỚC 3: THIẾT KẾ & GỬI PANEL ─────────────────── -->
      <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-3);">
        <div style="width:28px;height:28px;background:var(--surface-3);border:1px solid var(--border);border-radius:50%;display:grid;place-items:center;font-size:0.8rem;font-weight:700;color:var(--ink-3);flex-shrink:0;">3</div>
        <div>
          <div style="font-weight:600;color:var(--ink-1);">Tạo &amp; gửi panel lên Discord</div>
          <div style="font-size:0.8rem;color:var(--ink-3);">Chọn danh mục, thiết kế embed, gửi vào kênh bất kỳ</div>
        </div>
      </div>

      <!-- Existing panels -->
      <% if (typeof panels !== 'undefined' && panels.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:var(--sp-2);margin-bottom:var(--sp-4);">
        <div style="font-size:0.78rem;font-weight:600;color:var(--ink-3);text-transform:uppercase;letter-spacing:.05em;">Panel đã gửi</div>
        <% panels.forEach(p => { %>
        <div style="display:flex;align-items:center;gap:var(--sp-3);padding:var(--sp-3) var(--sp-4);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);">
          <i class="fas fa-layer-group" style="color:var(--teal);"></i>
          <span style="font-weight:600;color:var(--ink-1);font-size:0.875rem;flex:1;"><%= p.panelId %></span>
          <span style="font-size:0.75rem;color:var(--ink-3);">msg: <%= p.msgID %></span>
          <button class="btn btn-danger btn-sm" onclick="deletePanel('<%= p.panelId %>')"><i class="fas fa-trash"></i></button>
        </div>
        <% }); %>
      </div>
      <% } %>

      <div class="card">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-5);">
          <!-- Left: panel config -->
          <div style="display:flex;flex-direction:column;gap:var(--sp-4);">
            <div class="form-group">
              <label class="form-label">Panel ID <span style="color:var(--ink-3);font-weight:400;">(định danh nội bộ)</span></label>
              <input type="text" id="panelId" class="form-input" placeholder="panel-chinh">
            </div>
            <div class="form-group">
              <label class="form-label">Gửi vào kênh Discord <span style="color:var(--danger);font-size:0.75rem;">*</span></label>
              <input type="text" id="panelChannel" class="form-input" placeholder="ID kênh text">
            </div>
            <div class="form-group">
              <label class="form-label">Kiểu hiển thị danh mục</label>
              <div style="display:flex;gap:var(--sp-3);">
                <label style="flex:1;display:flex;align-items:center;gap:var(--sp-3);padding:var(--sp-3);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);cursor:pointer;" id="styleDropdownLabel">
                  <input type="radio" name="panelStyle" id="panelStyleDropdown" value="dropdown" <%= cfg['ticket.selectMenu'] !== false ? 'checked' : '' %> onchange="refreshPanelPreview()" style="accent-color:var(--teal);">
                  <span>
                    <strong style="font-size:0.875rem;color:var(--ink-1);">Dropdown</strong><br>
                    <span style="font-size:0.75rem;color:var(--ink-3);">Menu chọn — gọn, phù hợp nhiều danh mục</span>
                  </span>
                </label>
                <label style="flex:1;display:flex;align-items:center;gap:var(--sp-3);padding:var(--sp-3);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);cursor:pointer;" id="styleButtonLabel">
                  <input type="radio" name="panelStyle" id="panelStyleButton" value="button" <%= cfg['ticket.selectMenu'] === false ? 'checked' : '' %> onchange="refreshPanelPreview()" style="accent-color:var(--teal);">
                  <span>
                    <strong style="font-size:0.875rem;color:var(--ink-1);">Nút bấm</strong><br>
                    <span style="font-size:0.75rem;color:var(--ink-3);">Nút riêng — trực quan, tối đa 5 danh mục/hàng</span>
                  </span>
                </label>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Chọn danh mục hiển thị trên panel</label>
              <% if (categories && categories.length > 0) { %>
              <div style="display:flex;flex-direction:column;gap:var(--sp-2);padding:var(--sp-3);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);">
                <% categories.forEach(cat => { %>
                <label style="display:flex;align-items:center;gap:var(--sp-3);cursor:pointer;padding:var(--sp-2) var(--sp-3);background:var(--surface-3);border:1px solid var(--border);border-radius:var(--r-sm);font-size:0.875rem;color:var(--ink-2);">
                  <input type="checkbox" name="panelCat" value="<%= cat.categoryKey %>" onchange="refreshPanelPreview()" style="accent-color:var(--teal);width:16px;height:16px;">
                  <span style="font-size:1rem;"><%= cat.categoryEmoji||'🎫' %></span>
                  <span style="font-weight:500;color:var(--ink-1);"><%= cat.categoryName %></span>
                  <span style="font-family:monospace;font-size:0.72rem;color:var(--ink-3);margin-left:auto;"><%= cat.categoryKey %></span>
                </label>
                <% }); %>
              </div>
              <% } else { %>
              <div style="padding:var(--sp-3);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);font-size:0.875rem;color:var(--ink-3);">Tạo ít nhất 1 danh mục ở Bước 2 trước.</div>
              <% } %>
            </div>
            <div class="form-group">
              <label class="form-label">Tiêu đề embed panel</label>
              <input type="text" id="panelEmbedTitle" class="form-input" placeholder="🎫 Trung Tâm Hỗ Trợ" oninput="refreshPanelPreview()">
            </div>
            <div class="form-group">
              <label class="form-label">Nội dung embed panel</label>
              <textarea id="panelEmbedDesc" class="form-textarea" rows="3" placeholder="👋 Chào mừng bạn đến với hệ thống hỗ trợ!&#10;&#10;Chọn loại ticket phù hợp bên dưới để được hỗ trợ nhanh nhất." oninput="refreshPanelPreview()"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">Màu embed</label>
              <div style="display:flex;gap:var(--sp-3);align-items:center;">
                <input type="color" id="panelColorPicker" class="color-swatch" value="<%= cfg['bot.embedColor']||'#59d4b5' %>" oninput="document.getElementById('panelEmbedColor').value=this.value;refreshPanelPreview()">
                <input type="text" id="panelEmbedColor" class="form-input" value="<%= cfg['bot.embedColor']||'#59d4b5' %>" oninput="document.getElementById('panelColorPicker').value=this.value;refreshPanelPreview()">
              </div>
            </div>
          </div>

          <!-- Right: live panel preview -->
          <div style="position:sticky;top:80px;align-self:start;">
            <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);margin-bottom:var(--sp-3);">Xem trước panel trong Discord</div>
            <div style="background:#313338;border-radius:10px;padding:16px;">
              <div style="display:flex;border-radius:4px;overflow:hidden;background:#2b2d31;">
                <div id="panelPrevBar" style="width:4px;flex-shrink:0;background:<%= cfg['bot.embedColor']||'#59d4b5' %>;"></div>
                <div style="padding:10px 14px 10px 10px;flex:1;min-width:0;">
                  <div id="panelPrevTitle" style="font-size:0.875rem;font-weight:600;color:#fff;margin-bottom:4px;">🎫 Trung Tâm Hỗ Trợ</div>
                  <div id="panelPrevDesc" style="font-size:0.8rem;color:#dbdee1;white-space:pre-wrap;">👋 Chào mừng bạn đến với hệ thống hỗ trợ!

Chọn loại ticket phù hợp bên dưới để được hỗ trợ nhanh nhất.</div>
                  <div id="panelPrevBtns" style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
                    <span style="font-size:0.75rem;color:#949ba4;font-style:italic;">Chọn danh mục để xem nút...</span>
                  </div>
                </div>
              </div>
            </div>
            <button class="btn btn-primary" style="width:100%;margin-top:var(--sp-4);" onclick="sendPanel()">
              <i class="fas fa-paper-plane"></i> Gửi panel lên Discord
            </button>
            <span class="save-status" id="save-status-panels" style="display:block;text-align:center;margin-top:var(--sp-2);"></span>
          </div>
        </div>
      </div>

    </div><!-- /section-category -->


    <!-- ── TRANSCRIPT ────────────────────────────────────── -->
    <div class="setup-section" id="section-transcript">
      <div class="section-head">
        <h2>Transcript</h2>
        <p>Cài đặt cách lưu lịch sử hội thoại khi ticket đóng.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="transcriptType">Loại transcript</label>
          <select id="transcriptType" class="form-select">
            <option value="HTML" <%= (cfg['transcript.type'] || 'HTML') === 'HTML' ? 'selected' : '' %>>HTML (khuyến nghị, xem được trên Dashboard)</option>
            <option value="TXT" <%= cfg['transcript.type'] === 'TXT' ? 'selected' : '' %>>TXT (văn bản thuần)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="transcriptMsgReq">Số tin nhắn tối thiểu để tạo transcript</label>
          <input type="number" id="transcriptMsgReq" class="form-input" min="0"
                 value="<%= cfg['transcript.messagesRequirement'] || 1 %>">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="transcriptSaveFolder" <%= cfg['transcript.saveInFolder'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Lưu transcript vào thư mục local</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="transcriptSaveImages" <%= cfg['transcript.saveImages'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Lưu ảnh trong transcript (tăng dung lượng)</span>
        </label>
      </div>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('transcript')">
          <i class="fas fa-save"></i> Lưu cài đặt transcript
        </button>
        <span class="save-status" id="save-status-transcript"></span>
      </div>
    </div>

    <!-- ── CLAIMING ──────────────────────────────────────── -->
    <div class="setup-section" id="section-claiming">
      <div class="section-head">
        <h2>Claiming</h2>
        <p>Hệ thống nhận ticket: staff nhận ticket để xử lý độc quyền.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="claimMaxPerStaff">Số ticket tối đa mỗi staff nhận (0 = không giới hạn)</label>
          <input type="number" id="claimMaxPerStaff" class="form-input" min="0"
                 value="<%= cfg['claiming.maxPerStaff'] || 3 %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="claimMoveCategory">Category để chuyển ticket đã nhận (ID, tùy chọn)</label>
          <input type="text" id="claimMoveCategory" class="form-input" placeholder="ID Discord category"
                 value="<%= cfg['claiming.moveCategoryID'] || '' %>">
        </div>
        <div class="form-group span-2">
          <label class="form-label" for="autoClaimMsg">Tin nhắn khi auto-claim</label>
          <input type="text" id="autoClaimMsg" class="form-input"
                 placeholder="Ticket này đã được tự động nhận bởi {user}"
                 value="<%= cfg['claiming.autoClaim.message'] || 'Ticket này đã được tự động nhận bởi {user}' %>">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="claimEnabled" <%= cfg['claiming.enabled'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật hệ thống claiming</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="claimLockNew" <%= cfg['claiming.lockNewTickets'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Khóa ticket mới cho đến khi được nhận</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="autoClaimEnabled" <%= cfg['claiming.autoClaim.enabled'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Tự động nhận khi staff phản hồi</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="autoClaimShowMsg" <%= cfg['claiming.autoClaim.showMessage'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Hiển thị tin nhắn khi auto-claim</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="claimMoveEnabled" <%= cfg['claiming.moveEnabled'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Chuyển ticket đã nhận sang category riêng</span>
        </label>
      </div>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('claiming')">
          <i class="fas fa-save"></i> Lưu cài đặt claiming
        </button>
        <span class="save-status" id="save-status-claiming"></span>
      </div>
    </div>

    <!-- ── ALERT ─────────────────────────────────────────── -->
    <div class="setup-section" id="section-alert">
      <div class="section-head">
        <h2>Cảnh báo không hoạt động</h2>
        <p>Tự động cảnh báo và đóng ticket khi không có phản hồi trong thời gian dài.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="alertTime">Thời gian trước khi đóng</label>
          <input type="text" id="alertTime" class="form-input" placeholder="12h"
                 value="<%= cfg['alert.time'] || '12h' %>">
          <span class="form-hint">Ví dụ: 12h, 3d, 30m</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="autoAlertInactiveTime">Thời gian không hoạt động trước auto-alert</label>
          <input type="text" id="autoAlertInactiveTime" class="form-input" placeholder="3d"
                 value="<%= cfg['alert.autoAlert.inactiveTime'] || '3d' %>">
        </div>
        <div class="form-group span-2">
          <label class="form-label" for="alertMsg">Tin nhắn cảnh báo trong ticket</label>
          <textarea id="alertMsg" class="form-textarea" rows="3"
                    oninput="updateAlertPreview()"
                    placeholder="Ticket này đã không hoạt động trong {inactive-time}..."
                    ><%= cfg['alert.message'] || 'Ticket này đã không hoạt động trong ``{inactive-time}`` và sẽ tự động đóng vào **{time}** nếu không có phản hồi.' %></textarea>
          <span class="form-hint">Biến: {time}, {inactive-time}</span>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="alertEnabled" <%= cfg['alert.enabled'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật hệ thống cảnh báo</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="alertDmUser" <%= cfg['alert.dmUser'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">DM người dùng khi sắp đóng</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="autoAlertEnabled" <%= cfg['alert.autoAlert.enabled'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Tự động gửi cảnh báo khi không hoạt động</span>
        </label>
      </div>

      <!-- Alert preview -->
      <div class="preview-panel">
        <div class="preview-label">Xem trước tin nhắn cảnh báo</div>
        <div class="discord-preview">
          <div class="discord-embed">
            <div class="embed-accent-bar" style="background:#da373c;"></div>
            <div class="embed-body">
              <div class="embed-title">⏳ Cảnh báo không hoạt động</div>
              <div class="embed-description" id="alertPreviewMsg"><%= cfg['alert.message'] || 'Ticket này đã không hoạt động trong ``3 ngày`` và sẽ tự động đóng vào **&lt;t:1234567890:R&gt;** nếu không có phản hồi.' %></div>
              <div class="discord-buttons">
                <span class="discord-btn red">🔒 Đóng Ticket</span>
                <span class="discord-btn gray">🚫 Hủy đóng</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('alert')">
          <i class="fas fa-save"></i> Lưu cài đặt cảnh báo
        </button>
        <span class="save-status" id="save-status-alert"></span>
      </div>
    </div>

    <!-- ── WORKING HOURS ─────────────────────────────────── -->
    <div class="setup-section" id="section-workinghours">
      <div class="section-head">
        <h2>Giờ làm việc</h2>
        <p>Giới hạn thời gian tạo ticket theo lịch làm việc của team.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="whTimezone">Múi giờ</label>
          <input type="text" id="whTimezone" class="form-input" placeholder="Asia/Ho_Chi_Minh"
                 value="<%= cfg['workingHours.timezone'] || 'Asia/Ho_Chi_Minh' %>">
          <span class="form-hint">Ví dụ: Asia/Ho_Chi_Minh, Asia/Bangkok, UTC+7</span>
        </div>
        <div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);margin-bottom:var(--sp-5);">
        <label class="form-toggle">
          <input type="checkbox" id="whEnabled" <%= cfg['workingHours.enabled'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật giờ làm việc</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="whAllowOutside" <%= cfg['workingHours.allowOutside'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Cho phép tạo ticket ngoài giờ</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="whSendNotice" <%= cfg['workingHours.sendNotice'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Gửi thông báo khi tạo ngoài giờ</span>
        </label>
      </div>

      <!-- Schedule table -->
      <div class="card">
        <div class="card-header">
          <div class="card-icon"><i class="fas fa-calendar-week"></i></div>
          <h3 class="card-title">Lịch làm việc</h3>
        </div>
        <table class="wh-table">
          <thead>
            <tr>
              <th>Ngày</th>
              <th>Giờ làm việc</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% const days = [
              ['Monday','Thứ Hai'], ['Tuesday','Thứ Ba'], ['Wednesday','Thứ Tư'],
              ['Thursday','Thứ Năm'], ['Friday','Thứ Sáu'], ['Saturday','Thứ Bảy'], ['Sunday','Chủ Nhật']
            ];
            const schedule = cfg['workingHours.schedule'] || {};
            days.forEach(([day, label]) => {
              const val = schedule[day] || 'closed';
              const isClosed = val === 'closed';
            %>
            <tr>
              <td style="font-weight:500;color:var(--ink-1);"><%= label %></td>
              <td>
                <input type="text" class="form-input" id="wh-<%= day %>"
                       value="<%= isClosed ? '' : val %>"
                       placeholder="08:00-17:00"
                       style="max-width:160px;"
                       <%= isClosed ? 'disabled' : '' %>>
              </td>
              <td>
                <label class="form-toggle">
                  <input type="checkbox" id="wh-open-<%= day %>"
                         <%= !isClosed ? 'checked' : '' %>
                         onchange="toggleDay('<%= day %>')">
                  <span class="toggle-track"></span>
                  <span style="font-size:0.8rem;color:var(--ink-3);"><%= isClosed ? 'Đóng' : 'Mở' %></span>
                </label>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('workinghours')">
          <i class="fas fa-save"></i> Lưu giờ làm việc
        </button>
        <span class="save-status" id="save-status-workinghours"></span>
      </div>
    </div>

    <!-- ── REVIEW ─────────────────────────────────────────── -->
    <div class="setup-section" id="section-review">
      <div class="section-head">
        <h2>Đánh giá</h2>
        <p>Cho phép người dùng đánh giá chất lượng hỗ trợ sau khi ticket đóng.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="reviewChannelID">Kênh đăng đánh giá công khai (ID, tùy chọn)</label>
          <input type="text" id="reviewChannelID" class="form-input" placeholder="ID kênh"
                 value="<%= cfg['review.channel.channelID'] || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="reviewMinWords">Số từ tối thiểu cho nhận xét</label>
          <input type="number" id="reviewMinWords" class="form-input" min="0"
                 value="<%= cfg['review.minimumWords'] || 20 %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="reviewMaxWords">Số từ tối đa cho nhận xét</label>
          <input type="number" id="reviewMaxWords" class="form-input" min="1"
                 value="<%= cfg['review.maximumWords'] || 250 %>">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="reviewEnabled" <%= cfg['review.enabled'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật hệ thống đánh giá</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="reviewAskWhy" <%= cfg['review.askWhyModal'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Hỏi lý do đánh giá (modal)</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="reviewChannelEnabled" <%= cfg['review.channel.enabled'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Đăng đánh giá lên kênh công khai</span>
        </label>
      </div>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('review')">
          <i class="fas fa-save"></i> Lưu cài đặt đánh giá
        </button>
        <span class="save-status" id="save-status-review"></span>
      </div>
    </div>

    <!-- ── SUGGESTION ────────────────────────────────────── -->
    <div class="setup-section" id="section-suggestion">
      <div class="section-head">
        <h2>Đề xuất</h2>
        <p>Cho phép thành viên gửi đề xuất và bình chọn.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="suggestionChannelID">Kênh đăng đề xuất (ID)</label>
          <input type="text" id="suggestionChannelID" class="form-input" placeholder="ID kênh"
                 value="<%= cfg['suggestion.channelID'] || '' %>">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="suggestionEnabled" <%= cfg['suggestion.enabled'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật hệ thống đề xuất</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="suggestionThreads" <%= cfg['suggestion.createThreads'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Tạo thread thảo luận cho mỗi đề xuất</span>
        </label>
      </div>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('suggestion')">
          <i class="fas fa-save"></i> Lưu cài đặt đề xuất
        </button>
        <span class="save-status" id="save-status-suggestion"></span>
      </div>
    </div>

    <!-- ── DM NGƯỜI DÙNG ─────────────────────────────────── -->
    <div class="setup-section" id="section-dm">
      <div class="section-head">
        <h2>DM người dùng khi đóng ticket</h2>
        <p>Gửi tin nhắn riêng tư cho người tạo ticket khi ticket được đóng.</p>
      </div>
      <div class="form-grid">
        <div class="form-group span-2">
          <label class="form-label" for="dmCloseMsg">Nội dung DM khi đóng</label>
          <textarea id="dmCloseMsg" class="form-textarea" rows="4"
                    placeholder="Server {guildName} đã đóng ticket của bạn vào {closedAt}. Lý do: {close-reason}"
                    ><%= cfg['dm.closeMessage'] || 'Server {guildName} đã đóng ticket của bạn vào {closedAt}. Lý do: {close-reason}' %></textarea>
          <span class="form-hint">Biến: {guildName}, {closedAt}, {close-reason}</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="dmThumbnailURL">Thumbnail URL trong DM</label>
          <input type="url" id="dmThumbnailURL" class="form-input"
                 placeholder="https://i.imgur.com/example.png"
                 value="<%= cfg['dm.thumbnailURL'] || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="dmImageURL">Image URL trong DM</label>
          <input type="url" id="dmImageURL" class="form-input"
                 placeholder="https://i.imgur.com/banner.gif"
                 value="<%= cfg['dm.imageURL'] || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="dmFooterText">Footer text trong DM</label>
          <input type="text" id="dmFooterText" class="form-input"
                 placeholder="Heiznerd Support"
                 value="<%= cfg['dm.footerText'] || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="dmFooterIconURL">Footer icon URL trong DM</label>
          <input type="url" id="dmFooterIconURL" class="form-input"
                 placeholder="https://i.imgur.com/icon.png"
                 value="<%= cfg['dm.footerIconURL'] || '' %>">
        </div>
      </div>
      <label class="form-toggle" style="margin-top:var(--sp-4);">
        <input type="checkbox" id="dmEnabled" <%= cfg['dm.enabled'] !== false ? 'checked' : '' %>>
        <span class="toggle-track"></span>
        <span style="font-size:0.875rem;color:var(--ink-2);">Bật DM người dùng khi đóng ticket</span>
      </label>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('dm')">
          <i class="fas fa-save"></i> Lưu cài đặt DM
        </button>
        <span class="save-status" id="save-status-dm"></span>
      </div>
    </div>

    <!-- ── ĐỘ ƯU TIÊN ────────────────────────────────────── -->
    <div class="setup-section" id="section-priority">
      <div class="section-head">
        <h2>Độ ưu tiên ticket</h2>
        <p>Role nhất định sẽ tự động đánh dấu ticket của họ theo mức ưu tiên và thêm tiền tố vào tên kênh.</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-bottom:var(--sp-5);">
        <label class="form-toggle">
          <input type="checkbox" id="priorityEnabled" <%= cfg['priority.enabled'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật hệ thống độ ưu tiên</span>
        </label>
      </div>

      <!-- Priority levels list -->
      <div id="priorityLevelList" style="display:flex;flex-direction:column;gap:var(--sp-3);margin-bottom:var(--sp-4);">
        <% const pLevels = cfg['priority.levels'] || []; %>
        <% pLevels.forEach((lvl, i) => { %>
        <div class="priority-level-row" data-index="<%= i %>" style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-3) var(--sp-4);display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap;">
          <div class="form-group" style="flex:1;min-width:120px;">
            <label class="form-label">Tên mức</label>
            <input type="text" class="form-input pri-name" value="<%= lvl.name || '' %>" placeholder="Cao">
          </div>
          <div class="form-group" style="flex:1;min-width:120px;">
            <label class="form-label">Role ID</label>
            <input type="text" class="form-input pri-role" value="<%= lvl.roleID || '' %>" placeholder="123456789">
          </div>
          <div class="form-group" style="flex:1;min-width:100px;">
            <label class="form-label">Tiền tố kênh</label>
            <input type="text" class="form-input pri-prefix" value="<%= lvl.channelPrefix || '' %>" placeholder="🔴-">
          </div>
          <div class="form-group" style="flex:1;min-width:80px;">
            <label class="form-label">Mức (low/medium/high)</label>
            <input type="text" class="form-input pri-level" value="<%= lvl.priorityLevel || 'medium' %>" placeholder="high">
          </div>
          <button type="button" class="btn btn-danger btn-sm" style="margin-top:20px;" onclick="this.closest('.priority-level-row').remove()">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        <% }); %>
      </div>
      <button type="button" class="btn btn-secondary btn-sm" onclick="addPriorityLevel()">
        <i class="fas fa-plus"></i> Thêm mức ưu tiên
      </button>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('priority')">
          <i class="fas fa-save"></i> Lưu cài đặt ưu tiên
        </button>
        <span class="save-status" id="save-status-priority"></span>
      </div>
    </div>

    <!-- ── CHANNEL STATS ─────────────────────────────────── -->
    <div class="setup-section" id="section-channelstats">
      <div class="section-head">
        <h2>Kênh thống kê</h2>
        <p>Voice channel tự động cập nhật số liệu mỗi 5 phút.</p>
      </div>
      <% const statChannels = [
        ['totalTickets','Tổng ticket','{total-tickets}'],
        ['openTickets','Ticket đang mở','{open-tickets}'],
        ['averageRating','Đánh giá trung bình','⭐{average-rating}/5.0'],
        ['memberCount','Số thành viên','{member-count}']
      ]; %>
      <% statChannels.forEach(([key, label, placeholder]) => { %>
      <div class="card" style="margin-bottom:var(--sp-3);">
        <div style="display:flex;align-items:center;gap:var(--sp-4);">
          <label class="form-toggle" style="flex-shrink:0;">
            <input type="checkbox" id="cs-<%= key %>-enabled"
                   <%= cfg['channelStats.' + key + '.enabled'] ? 'checked' : '' %>>
            <span class="toggle-track"></span>
          </label>
          <div style="flex:1;">
            <div style="font-size:0.875rem;font-weight:600;color:var(--ink-1);margin-bottom:var(--sp-2);"><%= label %></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);">
              <div class="form-group">
                <label class="form-label">ID Voice Channel</label>
                <input type="text" id="cs-<%= key %>-channel" class="form-input" placeholder="ID kênh voice"
                       value="<%= cfg['channelStats.' + key + '.channelID'] || '' %>">
              </div>
              <div class="form-group">
                <label class="form-label">Tên kênh</label>
                <input type="text" id="cs-<%= key %>-name" class="form-input" placeholder="<%= placeholder %>"
                       value="<%= cfg['channelStats.' + key + '.channelName'] || placeholder %>">
              </div>
            </div>
          </div>
        </div>
      </div>
      <% }); %>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('channelstats')">
          <i class="fas fa-save"></i> Lưu kênh thống kê
        </button>
        <span class="save-status" id="save-status-channelstats"></span>
      </div>
    </div>

    <!-- ── ARCHIVE ───────────────────────────────────────── -->
    <div class="setup-section" id="section-archive">
      <div class="section-head">
        <h2>Lưu trữ ticket</h2>
        <p>Lưu trữ ticket thay vì xóa ngay khi đóng. Staff có thể mở lại hoặc xóa sau.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="archiveCategoryID">ID Discord category cho ticket lưu trữ</label>
          <input type="text" id="archiveCategoryID" class="form-input" placeholder="ID category"
                 value="<%= cfg['archive.categoryID'] || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="archivePrefix">Tiền tố tên kênh khi lưu trữ</label>
          <input type="text" id="archivePrefix" class="form-input" placeholder="archived-"
                 value="<%= cfg['archive.channelNamePrefix'] || 'archived-' %>">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-top:var(--sp-4);">
        <label class="form-toggle">
          <input type="checkbox" id="archiveEnabled" <%= cfg['archive.enabled'] ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Bật hệ thống lưu trữ</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="archiveHideCreator" <%= cfg['archive.hideFromCreator'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Ẩn ticket lưu trữ khỏi người tạo</span>
        </label>
        <label class="form-toggle">
          <input type="checkbox" id="archiveMoveCategory" <%= cfg['archive.moveToCategory'] !== false ? 'checked' : '' %>>
          <span class="toggle-track"></span>
          <span style="font-size:0.875rem;color:var(--ink-2);">Chuyển ticket sang category lưu trữ</span>
        </label>
      </div>
      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('archive')">
          <i class="fas fa-save"></i> Lưu cài đặt lưu trữ
        </button>
        <span class="save-status" id="save-status-archive"></span>
      </div>
    </div>

    <!-- ── VIETQR ─────────────────────────────────────────── -->
    <div class="setup-section" id="section-vietqr">
      <div class="section-head">
        <h2>VietQR</h2>
        <p>Cấu hình thanh toán qua mã QR ngân hàng Việt Nam. Dùng lệnh <code style="background:var(--surface-3);padding:2px 6px;border-radius:4px;font-size:0.8rem;">/invoice</code> để gửi hóa đơn.</p>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="vietqrBankId">Mã ngân hàng</label>
          <input type="text" id="vietqrBankId" class="form-input" placeholder="970422"
                 value="<%= cfg['vietqr.bankId'] || '' %>" oninput="updateVietQRPreview()">
          <span class="form-hint">Ví dụ: 970422 (MB Bank), 970436 (Vietcombank), 970415 (Vietinbank)</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="vietqrAccountNo">Số tài khoản</label>
          <input type="text" id="vietqrAccountNo" class="form-input" placeholder="0123456789"
                 value="<%= cfg['vietqr.accountNo'] || '' %>" oninput="updateVietQRPreview()">
        </div>
        <div class="form-group">
          <label class="form-label" for="vietqrAccountName">Tên chủ tài khoản</label>
          <input type="text" id="vietqrAccountName" class="form-input" placeholder="NGUYEN VAN A"
                 value="<%= cfg['vietqr.accountName'] || '' %>" oninput="updateVietQRPreview()">
        </div>
        <div class="form-group">
          <label class="form-label" for="vietqrTemplate">Template QR</label>
          <select id="vietqrTemplate" class="form-select" onchange="updateVietQRPreview()">
            <option value="compact2" <%= (cfg['vietqr.template'] || 'compact2') === 'compact2' ? 'selected' : '' %>>compact2 (khuyến nghị)</option>
            <option value="compact" <%= cfg['vietqr.template'] === 'compact' ? 'selected' : '' %>>compact</option>
            <option value="qr_only" <%= cfg['vietqr.template'] === 'qr_only' ? 'selected' : '' %>>qr_only</option>
            <option value="print" <%= cfg['vietqr.template'] === 'print' ? 'selected' : '' %>>print</option>
          </select>
        </div>
      </div>
      <label class="form-toggle" style="margin-top:var(--sp-4);">
        <input type="checkbox" id="vietqrOnlyTickets" <%= cfg['vietqr.onlyInTickets'] ? 'checked' : '' %>>
        <span class="toggle-track"></span>
        <span style="font-size:0.875rem;color:var(--ink-2);">Chỉ dùng lệnh /invoice trong kênh ticket</span>
      </label>

      <!-- VietQR preview -->
      <div class="preview-panel">
        <div class="preview-label">Xem trước hóa đơn VietQR</div>
        <div class="discord-preview">
          <div class="discord-embed">
            <div class="embed-accent-bar" style="background:<%= cfg['bot.embedColor'] || '#59d4b5' %>;"></div>
            <div class="embed-body">
              <div class="embed-title">💳 Hóa đơn thanh toán VietQR</div>
              <div class="embed-description">Vui lòng quét mã QR bên dưới để thanh toán.</div>
              <div style="margin-top:8px;font-size:0.8rem;color:#dbdee1;">
                <div>👤 Người nhận: <strong>@user</strong></div>
                <div>💰 Số tiền: <strong id="vqPreviewAmount">100,000 VND</strong></div>
                <div>📋 Dịch vụ: <strong>Dịch vụ hỗ trợ</strong></div>
                <div>🏦 Ngân hàng: <strong id="vqPreviewBank"><%= cfg['vietqr.accountName'] || 'Chưa cấu hình' %></strong></div>
              </div>
              <div style="margin-top:10px;background:#1e1f22;border-radius:6px;padding:8px;text-align:center;">
                <div id="vqPreviewQR" style="font-size:0.75rem;color:#949ba4;">
                  <% if (cfg['vietqr.bankId'] && cfg['vietqr.accountNo']) { %>
                    <img src="https://img.vietqr.io/image/<%= cfg['vietqr.bankId'] %>-<%= cfg['vietqr.accountNo'] %>-<%= cfg['vietqr.template'] || 'compact2' %>.png?amount=100000&addInfo=Preview&accountName=<%= encodeURIComponent(cfg['vietqr.accountName'] || '') %>"
                         style="max-width:200px;border-radius:4px;" alt="VietQR Preview">
                  <% } else { %>
                    Nhập thông tin ngân hàng để xem QR
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="save-bar">
        <button class="btn btn-primary" onclick="saveSection('vietqr')">
          <i class="fas fa-save"></i> Lưu cài đặt VietQR
        </button>
        <span class="save-status" id="save-status-vietqr"></span>
      </div>
    </div>
  </div><!-- /wizard-content -->
</div><!-- /wizard-layout -->

<script>
// ── Section navigation ────────────────────────────────────
const navItems = document.querySelectorAll('.wizard-nav-item');
const sections = document.querySelectorAll('.setup-section');

navItems.forEach(item => {
  item.addEventListener('click', e => {
    e.preventDefault();
    const target = item.dataset.section;
    navItems.forEach(n => n.classList.remove('active'));
    sections.forEach(s => s.classList.remove('active'));
    item.classList.add('active');
    const sec = document.getElementById('section-' + target);
    if (sec) sec.classList.add('active');
  });
});

// ── Preview helpers ───────────────────────────────────────
function updatePreviewColor(hex) {
  document.querySelectorAll('.embed-accent-bar').forEach(b => b.style.background = hex);
}

// ── Questions builder helper ──────────────────────────────
function addQuestion(key) {
  const container = document.getElementById('questions-' + key);
  if (!container) return;
  if (container.querySelectorAll('.question-row').length >= 5) { showToast('Tối đa 5 câu hỏi', 'error'); return; }
  const row = document.createElement('div');
  row.className = 'question-row';
  row.style.cssText = 'background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-sm);padding:var(--sp-3);display:grid;grid-template-columns:1fr 1fr auto;gap:var(--sp-2);align-items:start;';
  row.innerHTML = `
    <div class="form-group"><label class="form-label">Câu hỏi</label><input type="text" class="form-input q-label" placeholder="Bạn đang gặp vấn đề gì?"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-2);">
      <div class="form-group"><label class="form-label">Kiểu nhập</label><select class="form-select q-style"><option value="Short">Ngắn</option><option value="Paragraph">Dài</option></select></div>
      <div class="form-group"><label class="form-label">Bắt buộc</label><select class="form-select q-required"><option value="true">Có</option><option value="false">Không</option></select></div>
      <div class="form-group" style="grid-column:span 2;"><label class="form-label">Placeholder</label><input type="text" class="form-input q-placeholder" placeholder="Mô tả chi tiết..."></div>
    </div>
    <button type="button" class="btn btn-danger btn-sm" style="margin-top:20px;" onclick="this.closest('.question-row').remove()"><i class="fas fa-trash"></i></button>`;
  container.appendChild(row);
}

function collectQuestions(containerId) {
  return Array.from(document.querySelectorAll('#' + containerId + ' .question-row')).map((row, i) => ({
    customId: 'q' + (i + 1),
    question: row.querySelector('.q-label')?.value?.trim() || '',
    style:    row.querySelector('.q-style')?.value || 'Short',
    required: row.querySelector('.q-required')?.value === 'true',
    placeholder: row.querySelector('.q-placeholder')?.value?.trim() || '',
  })).filter(q => q.question);
}

// ── Category card toggle ──────────────────────────────────
function toggleCatCard(key) {
  const body = document.getElementById('cat-edit-' + key);
  const card = body?.closest('.cat-card');
  const chevron = card?.querySelector('.cat-chevron');
  const isOpen = body?.style.display !== 'none';
  // close all others
  document.querySelectorAll('.cat-edit-body').forEach(b => b.style.display = 'none');
  document.querySelectorAll('.cat-chevron').forEach(c => c.style.transform = '');
  document.querySelectorAll('.cat-card-row').forEach(r => r.style.borderRadius = '');
  if (!isOpen && body) {
    body.style.display = 'block';
    if (chevron) chevron.style.transform = 'rotate(180deg)';
    if (card) card.querySelector('.cat-card-row').style.borderRadius = 'var(--r-md) var(--r-md) 0 0';
  }
}

// ── Category card live preview ────────────────────────────
const COLOR_MAP = { Green:'#248046', Blurple:'#5865f2', Gray:'#4e5058', Red:'#da373c' };

function updateCatCardPreview(key) {
  const body  = document.getElementById('cat-edit-' + key);
  if (!body) return;
  const name  = body.querySelector('.ec-name')?.value  || key;
  const emoji = body.querySelector('.ec-emoji')?.value || '';
  const title = body.querySelector('.ec-title')?.value || name;
  const msg   = body.querySelector('.ec-msg')?.value   || '';
  const color = body.querySelector('.ec-color')?.value || 'Green';
  const t = document.getElementById('ec-title-' + key);
  const d = document.getElementById('ec-desc-'  + key);
  const b = document.getElementById('ec-btn-'   + key);
  if (t) t.textContent = title.replace('{category}', name);
  if (d) d.textContent = msg;
  if (b) { b.textContent = (emoji ? emoji + ' ' : '') + name; b.style.background = COLOR_MAP[color] || '#248046'; }
  const cn = document.getElementById('ec-prev-catname-' + key);
  if (cn) cn.textContent = name;
}

// ── Save existing category card ───────────────────────────
async function saveCatCard(key) {
  const body = document.getElementById('cat-edit-' + key);
  const g = cls => body?.querySelector(cls)?.value?.trim() || '';
  const c = cls => body?.querySelector(cls)?.checked ?? false;
  const payload = {
    key,
    name:          g('.ec-name'),
    emoji:         g('.ec-emoji'),
    category_channel: g('.ec-parent'),
    support_roles: g('.ec-roles'),
    logs_channel:  g('.ec-logs'),
    channel_name:  g('.ec-chname'),
    embed_title:   g('.ec-title'),
    embed_message: g('.ec-msg'),
    button_color:  g('.ec-color'),
    mention_roles: c('.ec-mention'),
    thumbnail_url: g('.ec-thumbnail'),
    image_url:     g('.ec-image'),
    footer_text:   g('.ec-footer-text'),
    footer_icon:   g('.ec-footer-icon'),
    dm_enabled:    c('.ec-dm-enabled'),
    dm_message:    g('.ec-dm-msg'),
    questions:     collectQuestions('questions-' + key),
  };
  try {
    const res  = await fetch('/api/setup/category/update', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
    const data = await res.json();
    if (data.success) { showToast('Đã lưu danh mục', 'success'); setTimeout(() => location.reload(), 600); }
    else showToast(data.error || 'Lỗi lưu danh mục', 'error');
  } catch { showToast('Lỗi kết nối', 'error'); }
}

// ── Delete category ───────────────────────────────────────
async function deleteCategory(key) {
  if (!confirm(`Xóa danh mục "${key}"? Hành động không thể hoàn tác.`)) return;
  try {
    const res  = await fetch('/api/setup/category/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ key }) });
    const data = await res.json();
    if (data.success) { showToast('Đã xóa', 'success'); document.querySelector(`.cat-card[data-key="${key}"]`)?.remove(); }
    else showToast(data.error || 'Lỗi xóa', 'error');
  } catch { showToast('Lỗi kết nối', 'error'); }
}

// ── New category live preview ─────────────────────────────
function refreshNewCatPreview() {
  const name  = document.getElementById('newCatName')?.value  || 'Hỗ Trợ';
  const emoji = document.getElementById('newCatEmoji')?.value || '';
  const title = document.getElementById('newCatTitle')?.value || `Ticket ${name}`;
  const msg   = document.getElementById('newCatMsg')?.value   || '> Cảm ơn bạn đã liên hệ.';
  const color = document.getElementById('newCatColor')?.value || 'Green';
  const t = document.getElementById('newCatPrevTitle');
  const d = document.getElementById('newCatPrevDesc');
  const b = document.getElementById('newCatPrevBtn');
  if (t) t.textContent = title.replace('{category}', name);
  if (d) d.textContent = msg;
  if (b) { b.textContent = (emoji ? emoji + ' ' : '🎫 ') + name; b.style.background = COLOR_MAP[color] || '#248046'; }
  const cn = document.getElementById('newCatPrevCatName');
  if (cn) cn.textContent = name;
}

// ── Create new category ───────────────────────────────────
async function createNewCategory() {
  const key   = document.getElementById('newCatKey')?.value?.trim();
  const name  = document.getElementById('newCatName')?.value?.trim();
  const parent= document.getElementById('newCatParent')?.value?.trim();
  const roles = document.getElementById('newCatRoles')?.value?.trim();
  if (!key || !name || !parent || !roles) { showToast('Điền đủ các trường bắt buộc (*)', 'error'); return; }
  const st = document.getElementById('save-status-newcat');
  if (st) st.textContent = 'Đang tạo...';
  try {
    const res  = await fetch('/api/setup/category/create', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        key, name,
        category_channel: parent,
        support_roles:    roles,
        emoji:        document.getElementById('newCatEmoji')?.value || '',
        logs_channel: document.getElementById('newCatLogs')?.value  || '',
        channel_name: document.getElementById('newCatChName')?.value || 'ticket-{username}',
        embed_title:  document.getElementById('newCatTitle')?.value  || '',
        embed_message:document.getElementById('newCatMsg')?.value    || '',
        button_color: document.getElementById('newCatColor')?.value  || 'Green',
        description:  '',
        thumbnail_url:document.getElementById('newCatThumbnail')?.value || '',
        image_url:    document.getElementById('newCatImage')?.value     || '',
        footer_text:  document.getElementById('newCatFooterText')?.value|| '',
        footer_icon:  document.getElementById('newCatFooterIcon')?.value|| '',
        dm_enabled:   document.getElementById('newCatDmEnabled')?.checked ?? false,
        dm_message:   document.getElementById('newCatDmMsg')?.value      || '',
        questions:    collectQuestions('questions-new'),
      }),
    });
    const data = await res.json();
    if (data.success) { showToast(`Đã tạo danh mục "${name}"`, 'success'); setTimeout(() => location.reload(), 700); }
    else { showToast(data.error || 'Lỗi tạo danh mục', 'error'); if (st) st.textContent = ''; }
  } catch { showToast('Lỗi kết nối', 'error'); if (st) st.textContent = ''; }
}

// ── Panel live preview ────────────────────────────────────
function refreshPanelPreview() {
  const title  = document.getElementById('panelEmbedTitle')?.value || '🎫 Trung Tâm Hỗ Trợ';
  const desc   = document.getElementById('panelEmbedDesc')?.value  || '👋 Chào mừng bạn đến với hệ thống hỗ trợ!\n\nChọn loại ticket phù hợp bên dưới để được hỗ trợ nhanh nhất.';
  const color  = document.getElementById('panelEmbedColor')?.value || '#59d4b5';
  const isDropdown = document.getElementById('panelStyleDropdown')?.checked;
  document.getElementById('panelPrevTitle').textContent = title;
  document.getElementById('panelPrevDesc').textContent  = desc;
  document.getElementById('panelPrevBar').style.background = color;
  const checked = [...document.querySelectorAll('input[name="panelCat"]:checked')];
  const btns = document.getElementById('panelPrevBtns');
  if (!btns) return;
  if (!checked.length) { btns.innerHTML = '<span style="font-size:0.75rem;color:#949ba4;font-style:italic;">Chọn danh mục để xem...</span>'; return; }
  if (isDropdown) {
    btns.innerHTML = `<div style="background:#1e1f22;border-radius:4px;padding:6px 10px;font-size:0.8rem;color:#dbdee1;width:100%;max-width:260px;display:flex;justify-content:space-between;align-items:center;">Chọn loại ticket... <span style="color:#949ba4;">▼</span></div>`;
  } else {
    btns.innerHTML = checked.map(cb => {
      const lbl = cb.closest('label');
      const txt = lbl ? lbl.querySelector('span:nth-child(3)')?.textContent?.trim() || cb.value : cb.value;
      const em  = lbl ? lbl.querySelector('span:nth-child(2)')?.textContent?.trim() || '' : '';
      return `<span style="background:#248046;color:#fff;padding:5px 14px;border-radius:3px;font-size:0.8rem;font-weight:500;">${em} ${txt}</span>`;
    }).join('');
  }
}

// ── Send panel ────────────────────────────────────────────
async function sendPanel() {
  const panelId = document.getElementById('panelId')?.value?.trim();
  const channel = document.getElementById('panelChannel')?.value?.trim();
  const cats    = [...document.querySelectorAll('input[name="panelCat"]:checked')].map(c => c.value);
  if (!panelId)     { showToast('Nhập Panel ID', 'error'); return; }
  if (!channel)     { showToast('Nhập ID kênh Discord', 'error'); return; }
  if (!cats.length) { showToast('Chọn ít nhất 1 danh mục', 'error'); return; }
  const st = document.getElementById('save-status-panels');
  if (st) st.textContent = 'Đang gửi...';
  try {
    const res  = await fetch('/api/setup/panel/send', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        panelId, channelId: channel, categories: cats,
        useDropdown: document.getElementById('panelStyleDropdown')?.checked ?? true,
        title: document.getElementById('panelEmbedTitle')?.value?.trim(),
        desc:  document.getElementById('panelEmbedDesc')?.value?.trim(),
        color: document.getElementById('panelEmbedColor')?.value?.trim(),
      }),
    });
    const data = await res.json();
    if (data.success) { showToast('Panel đã gửi!', 'success'); if (st) st.textContent = ''; setTimeout(() => location.reload(), 700); }
    else { showToast(data.error || 'Lỗi gửi panel', 'error'); if (st) st.textContent = ''; }
  } catch { showToast('Lỗi kết nối', 'error'); if (st) st.textContent = ''; }
}

// ── Delete panel ──────────────────────────────────────────
async function deletePanel(panelId) {
  if (!confirm(`Xóa panel "${panelId}"?`)) return;
  try {
    const res  = await fetch('/api/setup/panel/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ panelId }) });
    const data = await res.json();
    if (data.success) { showToast('Đã xóa panel', 'success'); setTimeout(() => location.reload(), 600); }
    else showToast(data.error || 'Lỗi xóa panel', 'error');
  } catch { showToast('Lỗi kết nối', 'error'); }
}


// ── Staff Roles helpers ───────────────────────────────────
function updateStaffRolesHidden() {
  const tags = document.querySelectorAll('#staffRolesContainer .staff-role-tag');
  const ids = Array.from(tags).map(t => t.dataset.id).filter(Boolean);
  document.getElementById('staffRoles').value = ids.join(',');
}

function addStaffRole() {
  const input = document.getElementById('staffRoleInput');
  const id = input.value.trim().replace(/\D/g, '');
  if (!id) return;
  const existing = document.querySelector(`#staffRolesContainer [data-id="${id}"]`);
  if (existing) { input.value = ''; return; }
  const tag = document.createElement('span');
  tag.className = 'staff-role-tag';
  tag.dataset.id = id;
  tag.style.cssText = 'display:inline-flex;align-items:center;gap:4px;background:var(--teal-glow);color:var(--teal);border:1px solid var(--teal-border);border-radius:4px;padding:2px 8px;font-size:0.8rem;font-weight:500;';
  tag.innerHTML = `<i class="fas fa-shield-alt" style="font-size:0.7rem;"></i><span class="role-name">${id}</span><button type="button" onclick="removeStaffRole('${id}')" style="background:none;border:none;cursor:pointer;color:var(--teal);padding:0;margin-left:2px;font-size:0.75rem;line-height:1;">×</button>`;
  document.getElementById('staffRolesContainer').appendChild(tag);
  updateStaffRolesHidden();
  input.value = '';
}

function removeStaffRole(id) {
  const tag = document.querySelector(`#staffRolesContainer [data-id="${id}"]`);
  if (tag) tag.remove();
  updateStaffRolesHidden();
}

// ── Ticket embed image/footer preview ────────────────────
function updateTicketEmbedPreview() {
  const thumbURL  = document.getElementById('ticketThumbnailURL')?.value?.trim();
  const imgURL    = document.getElementById('ticketImageURL')?.value?.trim();
  const footerTxt = document.getElementById('ticketFooterText')?.value?.trim();
  const useThumbnail = document.getElementById('ticketUserIconThumbnail')?.checked;

  const thumb  = document.getElementById('previewThumbnail');
  const img    = document.getElementById('previewImage');
  const footer = document.getElementById('previewFooter');

  if (thumb) {
    if (!useThumbnail && thumbURL) { thumb.src = thumbURL; thumb.style.display = 'block'; }
    else { thumb.style.display = 'none'; }
  }
  if (img) {
    if (imgURL) { img.src = imgURL; img.style.display = 'block'; }
    else { img.style.display = 'none'; }
  }
  if (footer) {
    if (footerTxt) { footer.textContent = footerTxt; footer.style.display = 'block'; }
    else { footer.style.display = 'none'; }
  }
}

// ── Priority level UI ─────────────────────────────────────
function addPriorityLevel() {
  const row = document.createElement('div');
  row.className = 'priority-level-row';
  row.style.cssText = 'background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-3) var(--sp-4);display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap;';
  row.innerHTML = `
    <div class="form-group" style="flex:1;min-width:120px;">
      <label class="form-label">Tên mức</label>
      <input type="text" class="form-input pri-name" placeholder="Cao">
    </div>
    <div class="form-group" style="flex:1;min-width:120px;">
      <label class="form-label">Role ID</label>
      <input type="text" class="form-input pri-role" placeholder="123456789">
    </div>
    <div class="form-group" style="flex:1;min-width:100px;">
      <label class="form-label">Tiền tố kênh</label>
      <input type="text" class="form-input pri-prefix" placeholder="🔴-">
    </div>
    <div class="form-group" style="flex:1;min-width:80px;">
      <label class="form-label">Mức (low/medium/high)</label>
      <input type="text" class="form-input pri-level" value="medium" placeholder="high">
    </div>
    <button type="button" class="btn btn-danger btn-sm" style="margin-top:20px;" onclick="this.closest('.priority-level-row').remove()">
      <i class="fas fa-trash"></i>
    </button>`;
  document.getElementById('priorityLevelList').appendChild(row);
}

// ── Embed appearance preview (thumbnail / image / footer) ─
function updateEmbedAppearancePreview() {
  const thumbURL    = document.getElementById('ticketThumbnailURL')?.value?.trim();
  const imgURL      = document.getElementById('ticketImageURL')?.value?.trim();
  const footerTxt   = document.getElementById('ticketFooterText')?.value?.trim();
  const footerIcon  = document.getElementById('ticketFooterIconURL')?.value?.trim();
  const useThumbnail= document.getElementById('ticketUserIconThumbnail')?.checked;

  const thumb = document.getElementById('appearanceThumb');
  const img   = document.getElementById('appearanceImage');
  const footer= document.getElementById('appearanceFooter');
  const ftxt  = document.getElementById('appearanceFooterText');
  const ficon = document.getElementById('appearanceFooterIcon');

  if (thumb) {
    const show = !useThumbnail && thumbURL;
    thumb.style.display = show ? 'block' : 'none';
    if (show) thumb.src = thumbURL;
  }
  if (img) {
    img.style.display = imgURL ? 'block' : 'none';
    if (imgURL) img.src = imgURL;
  }
  if (footer) footer.style.display = footerTxt ? 'flex' : 'none';
  if (ftxt)   ftxt.textContent = footerTxt || '';
  if (ficon) {
    ficon.style.display = footerIcon ? 'inline' : 'none';
    if (footerIcon) ficon.src = footerIcon;
  }
}

// ── Extended buildPayload entries ─────────────────────────
async function saveSection(section) {
  const statusEl = document.getElementById('save-status-' + section);
  if (statusEl) statusEl.textContent = 'Đang lưu...';

  const payload = buildPayload(section);

  try {
    const res = await fetch('/api/setup/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ section, ...payload }),
    });
    const data = await res.json();
    if (data.success) {
      showToast('Đã lưu thành công', 'success');
      if (statusEl) { statusEl.textContent = 'Đã lưu'; setTimeout(() => statusEl.textContent = '', 3000); }
      // Mark nav item as done
      document.querySelector(`.wizard-nav-item[data-section="${section}"]`)?.classList.add('done');
    } else {
      showToast(data.error || 'Lỗi khi lưu', 'error');
      if (statusEl) statusEl.textContent = '';
    }
  } catch (e) {
    showToast('Lỗi kết nối', 'error');
    if (statusEl) statusEl.textContent = '';
  }
}

function buildPayload(section) {
  const g = id => document.getElementById(id);
  const v = id => g(id)?.value ?? '';
  const c = id => g(id)?.checked ?? false;

  const payloads = {
    ticket: {
      logsChannelID: v('logsChannel'),
      maxTickets:    parseInt(v('maxTickets')) || 1,
      deleteTime:    parseInt(v('deleteTime')) || 5,
      cooldown:      parseInt(v('cooldown')) || 0,
      staffRoles:    v('staffRoles').split(',').map(s => s.trim()).filter(Boolean),
      channelTopic:  v('channelTopic'),
      mentionAuthor: c('mentionAuthor'),
      restrictClose: c('restrictClose'),
      closeReason:   c('closeReason'),
      selectMenu:    c('selectMenu'),
    },
    transcript: {
      type:                v('transcriptType'),
      saveInFolder:        c('transcriptSaveFolder'),
      saveImages:          c('transcriptSaveImages'),
      messagesRequirement: parseInt(v('transcriptMsgReq')) || 1,
    },
    claiming: {
      enabled:          c('claimEnabled'),
      maxPerStaff:      parseInt(v('claimMaxPerStaff')) || 3,
      lockNewTickets:   c('claimLockNew'),
      autoClaimEnabled: c('autoClaimEnabled'),
      autoClaimShowMsg: c('autoClaimShowMsg'),
      moveEnabled:      c('claimMoveEnabled'),
      moveCategoryID:   v('claimMoveCategory'),
      autoClaimMessage: v('autoClaimMsg'),
    },
    alert: {
      enabled:          c('alertEnabled'),
      time:             v('alertTime'),
      dmUser:           c('alertDmUser'),
      autoAlertEnabled: c('autoAlertEnabled'),
      inactiveTime:     v('autoAlertInactiveTime'),
      message:          v('alertMsg'),
    },
    workinghours: (() => {
      const days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
      const schedule = {};
      days.forEach(d => {
        const open = document.getElementById('wh-open-' + d)?.checked;
        schedule[d] = open ? (document.getElementById('wh-' + d)?.value || '08:00-17:00') : 'closed';
      });
      return {
        enabled:      c('whEnabled'),
        timezone:     v('whTimezone'),
        allowOutside: c('whAllowOutside'),
        sendNotice:   c('whSendNotice'),
        schedule,
      };
    })(),
    review: {
      enabled:        c('reviewEnabled'),
      askWhyModal:    c('reviewAskWhy'),
      channelEnabled: c('reviewChannelEnabled'),
      channelID:      v('reviewChannelID'),
      minimumWords:   parseInt(v('reviewMinWords')) || 20,
      maximumWords:   parseInt(v('reviewMaxWords')) || 250,
    },
    suggestion: {
      enabled:       c('suggestionEnabled'),
      channelID:     v('suggestionChannelID'),
      createThreads: c('suggestionThreads'),
    },
    channelstats: (() => {
      const keys = ['totalTickets','openTickets','averageRating','memberCount'];
      const result = {};
      keys.forEach(k => {
        result[k] = {
          enabled:     document.getElementById('cs-' + k + '-enabled')?.checked ?? false,
          channelID:   document.getElementById('cs-' + k + '-channel')?.value || '',
          channelName: document.getElementById('cs-' + k + '-name')?.value || '',
        };
      });
      return result;
    })(),
    archive: {
      enabled:           c('archiveEnabled'),
      hideFromCreator:   c('archiveHideCreator'),
      moveToCategory:    c('archiveMoveCategory'),
      categoryID:        v('archiveCategoryID'),
      channelNamePrefix: v('archivePrefix'),
    },
    vietqr: {
      bankId:       v('vietqrBankId'),
      accountNo:    v('vietqrAccountNo'),
      accountName:  v('vietqrAccountName'),
      template:     v('vietqrTemplate'),
      onlyInTickets:c('vietqrOnlyTickets'),
    },
    priority: (() => {
      const rows = document.querySelectorAll('.priority-level-row');
      const levels = Array.from(rows).map(r => ({
        name:          r.querySelector('.pri-name')?.value?.trim()   || '',
        roleID:        r.querySelector('.pri-role')?.value?.trim()   || '',
        channelPrefix: r.querySelector('.pri-prefix')?.value?.trim() || '',
        priorityLevel: r.querySelector('.pri-level')?.value?.trim()  || 'medium',
      })).filter(l => l.roleID);
      return { enabled: c('priorityEnabled'), levels };
    })(),
  };
  return payloads[section] || {};
}
</script>

