<%
  pageTitle = 'Trang chủ';
  activePage = 'home';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<div class="page-header">
  <h1 class="page-title">Xin chào, <%= user.username %></h1>
  <p class="page-subtitle">Tổng quan hoạt động và ticket gần đây của máy chủ.</p>
</div>

<!-- Stat tiles -->
<div class="stat-grid" style="margin-bottom: var(--sp-6);">
  <div class="stat-tile">
    <div class="stat-tile-icon"><i class="fas fa-ticket-alt"></i></div>
    <div class="stat-tile-label">Tổng ticket</div>
    <div class="stat-tile-value"><%= (guildStats.totalTickets || 0).toLocaleString('vi-VN') %></div>
  </div>
  <div class="stat-tile">
    <div class="stat-tile-icon"><i class="fas fa-envelope-open-text"></i></div>
    <div class="stat-tile-label">Tổng tin nhắn</div>
    <div class="stat-tile-value"><%= (guildStats.totalMessages || 0).toLocaleString('vi-VN') %></div>
  </div>
  <div class="stat-tile">
    <div class="stat-tile-icon"><i class="fas fa-reply"></i></div>
    <div class="stat-tile-label">Thời gian phản hồi TB</div>
    <div class="stat-tile-value" style="font-size:1.25rem;"><%= guildStats.averageResponse || 'N/A' %></div>
  </div>
  <div class="stat-tile">
    <div class="stat-tile-icon" style="background:oklch(0.82 0.18 80 / 0.15);color:var(--warning);"><i class="fas fa-star"></i></div>
    <div class="stat-tile-label">Đánh giá trung bình</div>
    <div class="stat-tile-value" style="font-size:1.25rem;">
      <%= averageRating %><span style="font-size:0.9rem;font-weight:400;color:var(--ink-3);">/5.0</span>
    </div>
  </div>
</div>

<!-- Recent tickets -->
<div class="card">
  <div class="card-header">
    <div class="card-icon"><i class="fas fa-clock-rotate-left"></i></div>
    <h2 class="card-title">Ticket gần đây</h2>
    <a href="/tickets" class="btn btn-ghost btn-sm" style="margin-left:auto;">Xem tất cả</a>
  </div>

  <% if (recentTickets && recentTickets.length > 0) { %>
    <% recentTickets.forEach(ticket => { %>
    <div class="ticket-row">
      <span class="ticket-id-badge">#<%= ticket.identifier %></span>
      <div class="ticket-user">
        <span class="ticket-username"><%= ticket.username || 'Unknown' %></span>
      </div>
      <div class="ticket-meta">
        <span class="badge badge-muted"><i class="fas fa-comments" style="margin-right:4px;"></i><%= ticket.messages || 0 %></span>
        <span class="badge badge-muted">
          <%= new Date(ticket.ticketCreationDate).toLocaleDateString('vi-VN', { day:'2-digit', month:'short', year:'numeric' }) %>
        </span>
      </div>
      <div class="ticket-actions">
        <span class="badge <%= ticket.status === 'Open' ? 'badge-teal' : 'badge-muted' %>">
          <%= ticket.status === 'Open' ? 'Đang mở' : 'Đã đóng' %>
        </span>
      </div>
    </div>
    <% }); %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon"><i class="fas fa-ticket-alt"></i></div>
      <p class="empty-title">Chưa có ticket nào</p>
      <p class="empty-body">Ticket sẽ xuất hiện ở đây khi thành viên tạo yêu cầu hỗ trợ.</p>
    </div>
  <% } %>
</div>

<%- include('partials/shell-close') %>
