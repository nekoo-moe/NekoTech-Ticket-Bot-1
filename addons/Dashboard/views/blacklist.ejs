<%
  pageTitle = 'Blacklist';
  activePage = 'blacklist';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<div class="page-header">
  <h1 class="page-title">Blacklist</h1>
  <p class="page-subtitle">Quản lý người dùng bị chặn khỏi hệ thống ticket.</p>
</div>

<% if (typeof invalidUserId !== 'undefined' && invalidUserId) { %>
<div style="background:oklch(0.65 0.22 25 / 0.12);border:1px solid oklch(0.65 0.22 25 / 0.3);border-radius:var(--r-md);padding:var(--sp-3) var(--sp-4);margin-bottom:var(--sp-5);display:flex;align-items:center;gap:var(--sp-3);">
  <i class="fas fa-exclamation-circle" style="color:var(--danger);"></i>
  <span style="font-size:0.875rem;color:var(--ink-2);">Không tìm thấy người dùng với ID này. Kiểm tra lại Discord User ID.</span>
</div>
<% } %>

<!-- Add user form -->
<div class="card" style="margin-bottom:var(--sp-5);">
  <div class="card-header">
    <div class="card-icon" style="background:oklch(0.65 0.22 25 / 0.12);color:var(--danger);border-color:oklch(0.65 0.22 25 / 0.25);">
      <i class="fas fa-user-plus"></i>
    </div>
    <h2 class="card-title">Thêm vào blacklist</h2>
  </div>
  <form action="/blacklist" method="POST" style="display:flex;gap:var(--sp-3);align-items:flex-end;flex-wrap:wrap;">
    <div class="form-group" style="flex:1;min-width:240px;">
      <label class="form-label" for="userId">Discord User ID</label>
      <input type="text" id="userId" name="userId" class="form-input"
             placeholder="123456789012345678" required
             pattern="[0-9]{17,20}" title="Nhập Discord User ID (17-20 chữ số)">
      <span class="form-hint">Chuột phải vào user trong Discord → Copy ID</span>
    </div>
    <input type="hidden" name="action" value="blacklist">
    <button type="submit" class="btn btn-danger" style="margin-bottom:22px;">
      <i class="fas fa-ban"></i> Chặn người dùng
    </button>
  </form>
</div>

<!-- Blacklisted users list -->
<div class="card">
  <div class="card-header">
    <div class="card-icon"><i class="fas fa-users-slash"></i></div>
    <h2 class="card-title">Người dùng bị chặn</h2>
    <span class="badge badge-muted" style="margin-left:auto;"><%= blacklistedUsers.length %></span>
  </div>

  <% if (blacklistedUsers.length > 0) { %>
    <% blacklistedUsers.forEach(u => { %>
    <div class="ticket-row" style="align-items:center;">
      <img src="<%= u.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
           alt="<%= u.username %>" class="ticket-avatar" style="width:36px;height:36px;border-radius:50%;">
      <div style="flex:1;min-width:0;">
        <div style="font-weight:600;color:var(--ink-1);font-size:0.875rem;"><%= u.username || 'Unknown User' %></div>
        <div style="font-size:0.75rem;color:var(--ink-3);font-family:monospace;"><%= u.userId %></div>
      </div>
      <% if (u.updatedAt) { %>
      <span class="badge badge-muted">
        <i class="fas fa-calendar-alt" style="margin-right:4px;"></i>
        <%= new Date(u.updatedAt).toLocaleDateString('vi-VN', { day:'2-digit', month:'short', year:'numeric' }) %>
      </span>
      <% } %>
      <div class="ticket-actions">
        <form action="/blacklist" method="POST"
              onsubmit="return confirm('Bỏ chặn <%= u.username %>?')">
          <input type="hidden" name="userId" value="<%= u.userId %>">
          <input type="hidden" name="action" value="unblacklist">
          <button type="submit" class="btn btn-ghost btn-sm">
            <i class="fas fa-user-check"></i> Bỏ chặn
          </button>
        </form>
      </div>
    </div>
    <% }); %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon"><i class="fas fa-shield-alt"></i></div>
      <p class="empty-title">Không có ai bị chặn</p>
      <p class="empty-body">Danh sách blacklist trống. Thêm người dùng bằng form bên trên.</p>
    </div>
  <% } %>
</div>

<%- include('partials/shell-close') %>
