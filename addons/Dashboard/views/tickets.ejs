<%
  pageTitle = 'Lịch sử ticket';
  activePage = 'tickets';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<div class="page-header">
  <h1 class="page-title">Lịch sử ticket</h1>
  <p class="page-subtitle">Xem transcript và thông tin các ticket đã đóng. Tổng: <strong style="color:var(--ink-1);"><%= totalTickets %></strong> ticket.</p>
</div>

<!-- Search -->
<form action="/tickets" method="GET" class="search-bar">
  <div class="search-wrap">
    <i class="fas fa-search search-icon"></i>
    <input type="text" name="search" class="form-input"
           placeholder="Tìm theo ID ticket hoặc Discord user ID..."
           value="<%= searchQuery || '' %>" style="padding-left:2.25rem;">
  </div>
  <button type="submit" class="btn btn-primary">Tìm kiếm</button>
  <% if (searchQuery) { %>
    <a href="/tickets" class="btn btn-ghost">
      <i class="fas fa-times"></i> Xóa
    </a>
  <% } %>
</form>

<div class="card">
  <% if (tickets.length > 0) { %>
    <% tickets.forEach(ticket => { %>
    <div class="ticket-row">
      <span class="ticket-id-badge">#<%= ticket.identifier %></span>
      <div class="ticket-user">
        <img src="<%= ticket.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
             alt="<%= ticket.username %>" class="ticket-avatar">
        <span class="ticket-username"><%= ticket.username || 'Unknown' %></span>
      </div>
      <div class="ticket-meta">
        <span class="badge badge-muted"><i class="fas fa-folder" style="margin-right:4px;"></i><%= ticket.ticketType || 'N/A' %></span>
        <span class="badge badge-muted"><i class="fas fa-comments" style="margin-right:4px;"></i><%= ticket.totalMessages || 0 %></span>
        <span class="badge badge-muted" style="background:oklch(0.72 0.18 145 / 0.1);color:var(--success);border-color:oklch(0.72 0.18 145 / 0.2);">
          <i class="fas fa-clock" style="margin-right:4px;"></i><%= ticket.createdAtFormatted %>
        </span>
        <span class="badge badge-red">
          <i class="fas fa-lock" style="margin-right:4px;"></i><%= ticket.closedAtFormatted %>
        </span>
      </div>
      <div class="ticket-actions">
        <% if (ticket.transcriptID) { %>
          <a href="/transcript?channelId=<%= ticket.channelID %>&dateNow=<%= ticket.transcriptID %>"
             class="btn btn-ghost btn-sm" target="_blank">
            <i class="fas fa-file-alt"></i> Transcript
          </a>
        <% } else { %>
          <span class="btn btn-ghost btn-sm" style="opacity:0.4;cursor:not-allowed;">
            <i class="fas fa-file-alt"></i> Không có
          </span>
        <% } %>
      </div>
    </div>
    <% }); %>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/tickets?page=1<%= searchQuery ? `&search=${searchQuery}` : '' %>" class="page-btn" aria-label="Trang đầu">
          <i class="fas fa-angles-left"></i>
        </a>
        <a href="/tickets?page=<%= currentPage - 1 %><%= searchQuery ? `&search=${searchQuery}` : '' %>" class="page-btn" aria-label="Trang trước">
          <i class="fas fa-angle-left"></i>
        </a>
      <% } %>
      <%
        const delta = 2;
        const range = [];
        for (let i = Math.max(1, currentPage - delta); i <= Math.min(totalPages, currentPage + delta); i++) range.push(i);
      %>
      <% range.forEach(i => { %>
        <a href="/tickets?page=<%= i %><%= searchQuery ? `&search=${searchQuery}` : '' %>"
           class="page-btn <%= i === currentPage ? 'active' : '' %>" aria-label="Trang <%= i %>"><%= i %></a>
      <% }); %>
      <% if (currentPage < totalPages) { %>
        <a href="/tickets?page=<%= currentPage + 1 %><%= searchQuery ? `&search=${searchQuery}` : '' %>" class="page-btn" aria-label="Trang sau">
          <i class="fas fa-angle-right"></i>
        </a>
        <a href="/tickets?page=<%= totalPages %><%= searchQuery ? `&search=${searchQuery}` : '' %>" class="page-btn" aria-label="Trang cuối">
          <i class="fas fa-angles-right"></i>
        </a>
      <% } %>
    </div>
    <% } %>

  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon"><i class="fas fa-history"></i></div>
      <p class="empty-title">Không tìm thấy ticket</p>
      <p class="empty-body"><%= searchQuery ? 'Không có kết quả cho "' + searchQuery + '".' : 'Chưa có ticket nào được đóng.' %></p>
    </div>
  <% } %>
</div>

<%- include('partials/shell-close') %>
