<%
  pageTitle = 'Đánh giá';
  activePage = 'reviews';
%>
<%- include('partials/shell-open', { user, accentColorHex, accentColorRgb, pageTitle, activePage }) %>

<style>
.review-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--sp-4);
  margin-top: var(--sp-5);
}
.review-card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-5);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  transition: border-color var(--dur-base), background var(--dur-base);
}
.review-card:hover { border-color: var(--teal-border); background: var(--surface-2); }
.review-user {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.review-avatar {
  width: 40px; height: 40px;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  flex-shrink: 0;
}
.review-username { font-weight: 600; color: var(--ink-1); font-size: 0.9rem; }
.review-date { font-size: 0.75rem; color: var(--ink-3); }
.review-stars { display: flex; gap: 3px; }
.review-stars i { font-size: 0.85rem; color: oklch(0.82 0.18 80); }
.review-stars i.far { color: var(--ink-3); }
.review-message {
  font-size: 0.875rem;
  color: var(--ink-2);
  line-height: 1.6;
  flex: 1;
}
.review-message.truncated { cursor: pointer; }
.review-message.truncated:hover { color: var(--ink-1); }
.review-footer {
  display: flex;
  gap: var(--sp-2);
  flex-wrap: wrap;
  padding-top: var(--sp-3);
  border-top: 1px solid var(--border);
}

/* Modal */
.modal-backdrop {
  position: fixed; inset: 0;
  background: oklch(0 0 0 / 0.7);
  z-index: var(--z-backdrop);
  display: none;
  place-items: center;
}
.modal-backdrop.open { display: grid; }
.modal-box {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  max-width: 480px;
  width: calc(100% - var(--sp-6));
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  animation: modal-in 200ms var(--ease-out) both;
}
@keyframes modal-in {
  from { opacity:0; transform: scale(0.96) translateY(8px); }
  to   { opacity:1; transform: scale(1) translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.modal-title { font-size: 1rem; font-weight: 700; color: var(--ink-1); }
.modal-close {
  width: 28px; height: 28px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  display: grid; place-items: center;
  cursor: pointer;
  color: var(--ink-3);
  font-size: 0.75rem;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.modal-close:hover { background: var(--surface-3); color: var(--ink-1); }
.modal-body { font-size: 0.9rem; color: var(--ink-2); line-height: 1.7; }
</style>

<div class="page-header">
  <h1 class="page-title">Đánh giá
    <span class="badge badge-muted" style="font-size:0.9rem;vertical-align:middle;margin-left:var(--sp-2);"><%= reviewsData.length %></span>
  </h1>
  <p class="page-subtitle">Phản hồi từ người dùng sau khi ticket được đóng.</p>
</div>

<!-- Sort + pagination controls -->
<div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-2);">
  <label class="form-label" style="margin:0;white-space:nowrap;">Sắp xếp:</label>
  <select class="form-select" style="max-width:220px;" id="sortDropdown" onchange="updateSort()">
    <option value="recent"    <%= sortOption === 'recent'    ? 'selected' : '' %>>Mới nhất</option>
    <option value="highToLow" <%= sortOption === 'highToLow' ? 'selected' : '' %>>Điểm cao → thấp</option>
    <option value="lowToHigh" <%= sortOption === 'lowToHigh' ? 'selected' : '' %>>Điểm thấp → cao</option>
  </select>
</div>

<% if (reviews.length > 0) { %>
<div class="review-grid">
  <% reviews.forEach((review, index) => { %>
  <div class="review-card">
    <div class="review-user">
      <img src="<%= review.userInfo.avatarURL || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
           alt="<%= review.userInfo.username %>" class="review-avatar">
      <div>
        <div class="review-username"><%= review.userInfo.username %></div>
        <div class="review-date"><%= new Date(review.createdAt).toLocaleDateString('vi-VN', { day:'2-digit', month:'short', year:'numeric' }) %></div>
      </div>
      <div class="review-stars" style="margin-left:auto;">
        <% for (let i = 0; i < Math.floor(review.rating); i++) { %><i class="fas fa-star"></i><% } %>
        <% if (review.rating % 1 !== 0) { %><i class="fas fa-star-half-alt"></i><% } %>
        <% for (let i = Math.ceil(review.rating); i < 5; i++) { %><i class="far fa-star"></i><% } %>
      </div>
    </div>

    <% if (review.reviewMessage) { %>
      <% if (review.reviewMessage.length > 120) { %>
        <p class="review-message truncated" onclick="openReviewModal(<%= index %>)">
          "<%= review.reviewMessage.substring(0, 120) %>…"
          <span style="color:var(--teal);font-size:0.8rem;"> Xem thêm</span>
        </p>
      <% } else { %>
        <p class="review-message">"<%= review.reviewMessage %>"</p>
      <% } %>
    <% } else { %>
      <p class="review-message" style="color:var(--ink-3);font-style:italic;">Không có nhận xét.</p>
    <% } %>

    <div class="review-footer">
      <span class="badge badge-muted"><i class="fas fa-folder" style="margin-right:4px;"></i><%= review.category || 'N/A' %></span>
      <span class="badge badge-muted"><i class="fas fa-comments" style="margin-right:4px;"></i><%= review.totalMessages || 0 %> tin nhắn</span>
    </div>
  </div>

  <!-- Modal data (hidden) -->
  <template id="review-data-<%= index %>">
    <div class="review-user" style="margin-bottom:var(--sp-3);">
      <img src="<%= review.userInfo.avatarURL || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
           alt="" class="review-avatar">
      <div>
        <div class="review-username"><%= review.userInfo.username %></div>
        <div class="review-stars" style="margin-top:4px;">
          <% for (let i = 0; i < Math.floor(review.rating); i++) { %><i class="fas fa-star"></i><% } %>
          <% if (review.rating % 1 !== 0) { %><i class="fas fa-star-half-alt"></i><% } %>
          <% for (let i = Math.ceil(review.rating); i < 5; i++) { %><i class="far fa-star"></i><% } %>
        </div>
      </div>
    </div>
    <p style="color:var(--ink-2);line-height:1.7;">"<%= review.reviewMessage %>"</p>
  </template>
  <% }); %>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
<div class="pagination" style="margin-top:var(--sp-6);">
  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage-1 %>&sort=<%= sortOption %>" class="page-btn"><i class="fas fa-angle-left"></i></a>
  <% } %>
  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?page=<%= i %>&sort=<%= sortOption %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
  <% } %>
  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage+1 %>&sort=<%= sortOption %>" class="page-btn"><i class="fas fa-angle-right"></i></a>
  <% } %>
</div>
<% } %>

<% } else { %>
<div class="card">
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-star"></i></div>
    <p class="empty-title">Chưa có đánh giá nào</p>
    <p class="empty-body">Đánh giá sẽ xuất hiện sau khi người dùng hoàn thành ticket và để lại phản hồi.</p>
  </div>
</div>
<% } %>

<!-- Review modal -->
<div class="modal-backdrop" id="reviewModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Đánh giá đầy đủ</span>
      <button class="modal-close" onclick="closeReviewModal()" aria-label="Đóng"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<script>
function updateSort() {
  const s = document.getElementById('sortDropdown').value;
  const p = new URLSearchParams(window.location.search);
  p.set('sort', s); p.set('page', 1);
  window.location.search = p.toString();
}
function openReviewModal(index) {
  const tpl = document.getElementById('review-data-' + index);
  if (!tpl) return;
  document.getElementById('modalBody').innerHTML = tpl.innerHTML;
  document.getElementById('reviewModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeReviewModal() {
  document.getElementById('reviewModal').classList.remove('open');
  document.body.style.overflow = '';
}
document.getElementById('reviewModal').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeReviewModal();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeReviewModal(); });
</script>

<%- include('partials/shell-close') %>
