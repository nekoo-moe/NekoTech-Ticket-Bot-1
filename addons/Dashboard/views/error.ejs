<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lỗi · Heiznerd Tickets</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <style>
    :root {
      --accent-color: <%= typeof accentColorHex !== 'undefined' ? accentColorHex : '#59d4b5' %>;
      --accent-color-rgb: <%= typeof accentColorRgb !== 'undefined' ? accentColorRgb : '89, 212, 181' %>;
    }
    body { display: grid; place-items: center; min-height: 100vh; }
    .error-wrap { width: 100%; max-width: 400px; padding: var(--sp-4); }
    .error-card {
      background: var(--surface-1);
      border: 1px solid oklch(0.65 0.22 25 / 0.3);
      border-radius: var(--r-xl);
      padding: var(--sp-7) var(--sp-6);
      text-align: center;
      display: flex; flex-direction: column; align-items: center; gap: var(--sp-4);
    }
    .error-icon {
      width: 56px; height: 56px;
      background: oklch(0.65 0.22 25 / 0.12);
      border: 1px solid oklch(0.65 0.22 25 / 0.3);
      border-radius: var(--r-lg);
      display: grid; place-items: center;
      color: var(--danger); font-size: 1.5rem;
    }
    .error-title { font-size: 1.15rem; font-weight: 700; color: var(--ink-1); }
    .error-body  { font-size: 0.875rem; color: var(--ink-3); max-width: 30ch; line-height: 1.5; }
  </style>
</head>
<body>
  <div class="error-wrap">
    <div class="error-card">
      <div class="error-icon"><i class="fas fa-triangle-exclamation"></i></div>
      <h1 class="error-title">Đã xảy ra lỗi</h1>
      <p class="error-body"><%= message || 'Có lỗi không xác định. Vui lòng thử lại.' %></p>
      <a href="/" class="btn btn-ghost">
        <i class="fas fa-arrow-left"></i> Về trang chủ
      </a>
    </div>
  </div>
</body>
</html>
